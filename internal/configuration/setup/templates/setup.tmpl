{{define "setup"}}<!DOCTYPE html>
<html lang="{{.UI.Language}}">
	<head>
		<title>{{.UITitle}}</title>
		<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
		<script>window.gokapiMessages = {{.UI.Messages}};</script>
        <script src="./ui.js?v=1"></script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link href="./bootstrap/bootstrap.css" rel="stylesheet">
		<link href="./src/bootstrap-wizard.css" rel="stylesheet">
		<link href="./chosen/chosen.css" rel="stylesheet">
		<style>
			.wizard-modal p {
				margin: 0 0 10px;
				padding: 0;
			}

			#wizard-ns-detail-servers, .wizard-additional-servers {
				font-size: 12px;
				margin-top: 10px;
				margin-left: 15px;
			}
			#wizard-ns-detail-servers > li, .wizard-additional-servers li {
				line-height: 20px;
				list-style-type: none;
			}
			#wizard-ns-detail-servers > li > img {
				padding-right: 5px;
			}

			.wizard-modal .chzn-container .chzn-results {
				max-height: 150px;
			}
			.wizard-addl-subsection {
				margin-bottom: 40px;
			}
			.create-server-agent-key {
				margin-left: 15px; 
				width: 90%;
			}
			
			

			    .oauthscopecontainer {
			      margin: 0 auto;
			    }

			    .oauthscopes {
				display: flex;
				flex-wrap: wrap;
				align-items: center; /* Align items vertically in the center */
				margin-bottom: 5px;
			    }

			    #oauth_restrict_users, #oauth_restrict_groups {
			      margin-right: 10px;
			    }

			    #label_ousers, #label_ogroups {
			      margin-right: 10px;
			    }
			    

		</style>
		<!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
		<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
		<!--[if lt IE 9]>
		<script src="js/html5shiv-3.7.0.js"></script>
		<script src="js/respond-1.3.0.min.js"></script>
		<![endif]-->
	</head>
	<body style="padding:30px;">

		

		<div class="wizard" id="satellite-wizard" data-title="{{$.UI.T "setup.title"}}">



			<!-- Step 0 Welcome -->
			<div class="wizard-card wizard-card-overlay" data-cardname="{{$.UI.T "setup.welcome"}}">
				<h3>{{$.UI.T "setup.welcome"}}</h3>
                <div style="margin-bottom:15px" aria-label="{{.UI.T "language.label"}}">
                    <button type="button" class="btn" onclick="switchSetupLanguage('zh-CN')" lang="zh-CN">中文</button>
                    <button type="button" class="btn" onclick="switchSetupLanguage('en')" lang="en">English</button>
                </div>

				<div class="wizard-input-section">
				
{{ if .IsInitialSetup }}
					<p>
						{{$.UI.T "setup.welcomeIntro"}} <a href="https://gokapi.readthedocs.io/en/stable/" title="{{$.UI.T "setup.documentationTitle"}}" target="_blank">{{$.UI.T "setup.documentation"}}</a>.
					</p>
{{ else }}
					<p>
						{{$.UI.T "setup.reconfigureIntro"}} <a href="https://gokapi.readthedocs.io/en/stable/" title="{{$.UI.T "setup.documentationTitle"}}" target="_blank" rel="noopener noreferrer">{{$.UI.T "setup.documentation"}}</a>.
					</p>
{{ end }}
					<br>
{{ if .IsDataNotMounted }}
					<p>
					<span style="color:#FF0000;"><b>{{$.UI.T "setup.warning"}}</b> {{$.UI.T "setup.dataMountBefore"}} <code>/app/data</code> {{$.UI.T "setup.mountAfter"}}</span>
					</p>
{{ end }}
{{ if .IsConfigNotMounted }}
					<p>
					<span style="color:#FF0000;"><b>{{$.UI.T "setup.warning"}}</b> {{$.UI.T "setup.dataMountBefore"}} <code>/app/config</code> {{$.UI.T "setup.mountAfter"}}</span>
					</p>
{{ end }}

				</div>
			</div>
			<!-- Step 1 DB Location -->
			<div class="wizard-card wizard-card-overlay" data-cardname="dblocation">
				<h3 style="display:none">{{$.UI.T "setup.database"}}</h3>

				<div class="wizard-input-section">
					<div class="form-group">
					
{{ if not .IsInitialSetup }}
				<p>
					<span style="color:red"><b>{{$.UI.T "setup.warning"}}</b> {{$.UI.T "setup.migrateBefore"}} <code>gokapi migrate-database</code> {{$.UI.T "setup.migrateAfter"}}</span>
				</p><br>
{{ end }}

							  <label for="dbtype_sel">{{$.UI.T "setup.databaseType"}}</label>
						<select name="dbtype_sel" id="dbtype_sel"  style="width:350px;" class="select form-control"  onChange="dbChanged()">	
								<option value="0" selected>SQLite</option>
								<option value="1">Redis</option>

						</select><br>
						<div id="divsqlite">
							<label for="sqlite_location">{{$.UI.T "setup.databaseLocation"}}:</label>
							<input type="text" class="form-control" id="sqlite_location" name="sqlite_location" value="./data/gokapi.sqlite" placeholder="{{$.UI.T "setup.databaseLocation"}}" required><br>
						</div>
						<div id="divredis" style="display: none;">
							<label for="redis_location">{{$.UI.T "setup.databaseHost"}}:</label>
							<input type="text" class="form-control" id="redis_location" name="redis_location" value="127.0.0.1:6379" placeholder="{{$.UI.T "setup.databaseHost"}}" required><br>
							<label for="redis_prefix">{{$.UI.T "setup.keyPrefix"}}:</label>
                            <input type="text" class="form-control" id="redis_prefix" name="redis_prefix" value="gokapi_" placeholder="{{$.UI.T "setup.optional"}}"><br>
							<label for="redis_user">{{$.UI.T "setup.username"}}:</label>
                            <input type="text" class="form-control" id="redis_user" name="redis_user" value="" placeholder="{{$.UI.T "setup.optional"}}"><br>
							<label for="redis_password">{{$.UI.T "setup.passwordPlain"}}:</label>
                            <input type="text" class="form-control" id="redis_password" name="redis_password" value="" placeholder="{{$.UI.T "setup.optional"}}"><br>
							<label for="redis_ssl_sel">{{$.UI.T "setup.useSSL"}}</label>
							<select name="redis_ssl_sel" id="redis_ssl_sel" style="width:350px;" class="select form-control">
								<option value="0" selected>{{$.UI.T "setup.no"}}</option>
								<option value="1">{{$.UI.T "setup.yes"}}</option>
							</select>
						</div>
					</div>
				</div>
			</div>
						
			
			<!-- Step 2 Webserver -->
			<div class="wizard-card wizard-card-overlay" data-cardname="webserver1">
				<h3 style="display:none">{{$.UI.T "setup.webserver1"}}</h3>

				<div class="wizard-input-section">
					<div class="form-group">

							  <label for="localhost_sel">{{$.UI.T "setup.localhost"}}</label>
						<select name="localhost_sel" id="localhost_sel"  style="width:350px;" class="select form-control" {{ if .IsDocker }}disabled{{ end }}>	
{{ if .IsDocker }}
								<option value="0" selected>{{$.UI.T "setup.dockerUnsupported"}}</option>
{{ else }}
								<option value="0" selected>{{$.UI.T "setup.no"}}</option>
								<option value="1">{{$.UI.T "setup.yes"}}</option>
{{ end }}

						</select><br>
							
							  <label for="ssl_sel">{{$.UI.T "setup.sslHelp"}}</label>
						<select name="ssl_sel" id="ssl_sel" style="width:350px;" onChange="urlParamChanged()" class="select form-control">
								<option value="0" selected>{{$.UI.T "setup.no"}}</option>
								<option value="1">{{$.UI.T "setup.yes"}}</option>

						</select><br>
						
							  <label for="logip_sel">{{$.UI.T "setup.logIP"}} <i>{{$.UI.T "setup.privacyNote"}}</i></label>
						<select name="logip_sel" id="logip_sel" style="width:350px;" class="select form-control">
								<option value="0" selected>{{$.UI.T "setup.no"}}</option>
								<option value="1">{{$.UI.T "setup.yes"}}</option>
						</select><br>
						
							  <label for="showfilename_sel">{{$.UI.T "setup.includeFilename"}}</label>
						<select name="showfilename_sel" id="showfilename_sel" style="width:350px;" class="select form-control">
								<option value="0" selected>{{$.UI.T "setup.no"}}</option>
								<option value="1">{{$.UI.T "setup.yes"}}</option>
						</select>
					</div>
				</div>
			</div>
			
			<!-- Step 3 Webserver 2 -->
			<div class="wizard-card wizard-card-overlay" data-cardname="webserver2">
				<h3 style="display:none">{{$.UI.T "setup.webserver2"}}</h3>

				<div class="wizard-input-section">
					<div class="form-group">

							  <label for="public_name">{{$.UI.T "setup.publicName"}}:</label>
								<input type="text" class="form-control" id="public_name" name="public_name" value="Gokapi" placeholder="{{$.UI.T "setup.publicName"}}" required>
							  <br><label for="port">{{$.UI.T "setup.port"}}:</label>
{{ if .IsDocker }}
							<input type="number" class="form-control" id="port" value="53842" placeholder="{{$.UI.T "setup.portNumber"}}" disabled>
							<input type="hidden" class="form-control" name="port" value="53842">
{{ else }}
							<input type="number" class="form-control" id="port" name="port" value="53842" min="1" max="65535" placeholder="{{$.UI.T "setup.portNumber"}}" data-min="1" data-validate="validateMinLength" required onChange="urlParamChanged()">
{{ end }}
							

							  <br><label for="url">{{$.UI.T "setup.publicURLLabel"}}</label>
								<input type="text" class="form-control" id="url" name="url" value="http://127.0.0.1:53842/" placeholder="{{$.UI.T "setup.publicURL"}}" data-min="8" required data-validate="validateUrl">
							
							

							  <br><label for="url_redirection">{{$.UI.T "setup.redirectLabel"}}</label>
								<input type="text" class="form-control" id="url_redirection" name="url_redirection" value="https://github.com/Forceu/Gokapi/" placeholder="{{$.UI.T "setup.redirectURL"}}" required data-min="1" data-validate="validateMinLength">
						</div>
				</div>
			</div>
			
			


			<!-- Step 4 Auth -->
			<div class="wizard-card wizard-card-overlay" data-cardname="authentication">
				<h3 style="display:none">{{$.UI.T "setup.authentication"}}</h3>

				<div class="wizard-input-section">
					<div class="form-group">
					<p>
						{{$.UI.T "setup.authChoose"}}
					</p>


						<select name="authentication_sel" id="authentication_sel" style="width:350px;" class="select form-control" onchange="authSelectionChanged(this.value);">
							<optgroup label="{{$.UI.T "setup.standalone"}}">
								<option value="0" selected>{{$.UI.T "setup.usernamePassword"}}</option>
								<option value="1" >OAuth2 OpenID Connect</option>
							</optgroup>

							<optgroup label="{{$.UI.T "setup.reverseProxy"}}">
								<option value="2">{{$.UI.T "setup.trustedHeader"}}</option>
								<option value="3">{{$.UI.T "setup.disabledAuth"}}</option>
							</optgroup>

						</select>
					</div>
				</div>
			</div>

			<!-- Step 5a Credentials PW -->
			<div class="wizard-card wizard-card-overlay" data-cardname="credentials">
				<h3 style="display:none">{{$.UI.T "setup.credentials"}}</h3>


				<div class="wizard-input-section">
						<div class="form-group">
					<p>
						{{$.UI.T "setup.credentialsHelp"}}
					</p>

							<div class="col-sm-8">
								<input type="text" class="form-control" id="auth_username" name="auth_username" placeholder="{{$.UI.T "setup.username"}}" data-min="3" required data-validate="validateMinLength">
							</div><br><br>
							<div class="col-sm-8">
								<input type="password" autocomplete="new-password" class="form-control" id="auth_pw" name="auth_pw" placeholder="{{$.UI.T "setup.password"}}" data-min={{ .MinPasswordLength }} required data-validate="validatePassword">
							</div><br><br>
							<div class="col-sm-8">
								<input type="password" autocomplete="new-password" class="form-control" id="auth_pw2" name="auth_pw2" placeholder="{{$.UI.T "setup.passwordRepeat"}}" data-min={{ .MinPasswordLength }} required>
						</div>
					</div>


				</div>
			</div>
			
			<!-- Step 5b Credentials Oauth -->
			<div class="wizard-card wizard-card-overlay" data-cardname="credentials-oauth">
				<h3 style="display:none">{{$.UI.T "setup.credentials"}}</h3>


					<div class="wizard-input-section">
						<div class="form-group">
					<p>
						{{$.UI.T "setup.oidcIntro"}} <a href="https://gokapi.readthedocs.io/en/stable/setup.html#oauth2-openid-connect" target="_blank" rel="noopener noreferrer">{{$.UI.T "setup.documentation"}}</a> {{$.UI.T "setup.oidcAfter"}}<br>
					</p>

							<div class="col-sm-8" style="width:90%">
							  <label for="oauth_provider">{{$.UI.T "setup.providerURL"}}:</label>
								<input type="text" class="form-control" id="oauth_provider" name="oauth_provider" placeholder="{{$.UI.T "setup.providerURL"}}" data-min="1" required data-validate="validateMinLength">
							</div>

							<div class="col-sm-8" style="width:90%">
							  <label for="oauth_id">{{$.UI.T "setup.clientID"}}:</label>
								<input type="text" class="form-control" id="oauth_id" name="oauth_id" placeholder="{{$.UI.T "setup.clientID"}}" data-min="1" required data-validate="validateMinLength">
							</div>

							<div class="col-sm-8" style="width:90%">
							  <label for="oauth_secret">{{$.UI.T "setup.clientSecret"}}:</label>
								<input type="text" class="form-control" id="oauth_secret" name="oauth_secret" placeholder="{{$.UI.T "setup.clientSecret"}}" data-min="1" required data-validate="validateMinLength">
							</div>
							<div class="col-sm-8" style="width:90%">
							  <label for="oauth_admin_user">{{$.UI.T "setup.adminEmail"}}:</label>
								<input type="text" class="form-control" id="oauth_admin_user" name="oauth_admin_user" placeholder="{{$.UI.T "setup.adminEmail"}}" data-min="3" required data-validate="validateMinLength">
							</div>
							<div class="col-sm-8" style="width:90%">
                            {{$.UI.T "setup.recheck"}}
							<select name="oauth_recheck_interval" id="oauth_recheck_interval" style="width:350px;" class="select form-control">
								<option value="6"> {{$.UI.T "setup.hours6"}}</option>
								<option value="12" selected>{{$.UI.T "setup.hours12"}}</option>
								<option value="24">{{$.UI.T "setup.hours24"}}</option>
								<option value="72"> {{$.UI.T "setup.days3"}}</option>
								<option value="168">{{$.UI.T "setup.days7"}}</option>
								<option value="336">{{$.UI.T "setup.days14"}}</option>
								<option value="720">{{$.UI.T "setup.days30"}}</option>
						</select>
							</div>
							<div class="col-sm-8" style="width:90%">
							<br>{{$.UI.T "setup.restrictTo"}}
								  <div class="oauthscopecontainer">
								    <div class="oauthscopes">
								      <input type="hidden" name="oauth_restrict_groups.unchecked" value="false">
								      <input type="checkbox" id="oauth_restrict_groups" name="oauth_restrict_groups" onchange="handleOauthCheckboxChange(this)"  value="true">
								      <label id="label_ogroups" for="oauth_restrict_groups" class="checkboxLabel">{{$.UI.T "setup.groups"}}</label>
								      <input type="text" id="oauth_scope_groups" name="oauth_scope_groups" class="input-field" placeholder="{{$.UI.T "setup.scopeIdentifier"}}" data-min="1" data-validate="validateMinLength" disabled>&nbsp;
								      <input type="text" id="oauth_allowed_groups" name="oauth_allowed_groups" class="input-field" placeholder="{{$.UI.T "setup.allowedGroups"}}" data-min="1" data-validate="validateMinLength" disabled>
								    </div>
								    
								     <div><br>
								     <input type="hidden" name="oauth_only_registered_users.unchecked" value="false">
								     <input  id="oauth_only_registered_users" name="oauth_only_registered_users" type="checkbox" value="true">
								     <span>&nbsp;{{$.UI.T "setup.registeredOnly"}}</span>
								     </div>
								  </div>
							</div> 
							<div class="col-sm-8" style="width:90%">
							 <label for="oauth_redir"><br>{{$.UI.T "setup.redirectURL"}}:</label>
{{ if .IsInitialSetup }}
								<input type="text" style="cursor:default" class="form-control" id="oauth_redir" name="oauth_redir" disabled value="http://127.0.0.1:53842/oauth-callback">
{{ else }}
								<input type="text" style="cursor:default" class="form-control" id="oauth_redir" name="oauth_redir" disabled value="{{ .Settings.ServerUrl }}oauth-callback">
{{ end }}
							</div><br><br>

					</div>

				</div>
			</div>
			
			<!-- Step 5c Credentials Header -->
			<div class="wizard-card wizard-card-overlay" data-cardname="credentials-header">
				<h3 style="display:none">{{$.UI.T "setup.credentials"}}</h3>


				<div class="wizard-input-section">
						<div class="form-group">
					<p>
						{{$.UI.T "setup.headerHelp"}}<br><br>
					</p>

							<p>
							  <label for="auth_headerkey">{{$.UI.T "setup.headerKey"}}:</label>
								<input type="text" class="form-control" id="auth_headerkey" name="auth_headerkey" data-min="1" required placeholder="{{$.UI.T "setup.headerKey"}}" data-validate="validateMinLength">
							</p>
							
							<p>
							  <label for="auth_header_admin">{{$.UI.T "setup.adminUsername"}}:</label>
								<input type="text" class="form-control" id="auth_header_admin" name="auth_header_admin" data-min="3"  data-validate="validateMinLength" required placeholder="{{$.UI.T "setup.adminUsername"}}">
							</p>
						
						    <br>
						     <input type="hidden" name="auth_header_only_registered_users.unchecked" value="false">
						     <input id="auth_header_only_registered_users" name="auth_header_only_registered_users" type="checkbox" value="true">
						     <span>&nbsp;{{$.UI.T "setup.registeredOnly"}}</span>
					</div>
				</div>
			</div>
			<!-- Step 5d Credentials Disbabled -->
			<div class="wizard-card wizard-card-overlay" data-cardname="credentials-disabled">
				<h3 style="display:none">{{$.UI.T "setup.credentials"}}</h3>


				<div class="wizard-input-section">
					<p>
						<span style="color:#FF0000;">{{$.UI.T "setup.warning"}}</span> {{$.UI.T "setup.disabledAuthHelp"}}
						
						<ul>
{{ range .ProtectedUrls }}
						  <li><code>{{ . }}</code></li>
{{ end }}
						</ul>

						{{$.UI.T "setup.disabledAuthProceed"}}
					</p>

				</div>
			</div>



			<!-- Step 6 Storage -->
			<div class="wizard-card wizard-card-overlay" data-cardname="storage">
				<h3 style="display:none">{{$.UI.T "setup.storage"}}</h3>

				<div class="wizard-input-section">
					<p>
						{{$.UI.T "setup.storageChoose"}}
					</p>

					<select name="storage_sel" id="storage_sel" style="width:350px;" class="select form-control" onchange="storageSelectionChanged(this.selectedIndex);">
							<option value="local" selected>{{$.UI.T "setup.localStorage"}}</option>
							<option value="cloud" {{ if not .HasAwsFeature }} disabled {{ end }} >{{$.UI.T "setup.cloudStorage"}}</option>

					</select>
					
{{ if not .HasAwsFeature }}
					<p><br><br><i>{{$.UI.T "setup.noAWS"}}</i></p>
					
			  				<input type="hidden" id="storage_sel_image" name="storage_sel_image" value="nochange">

						</select>
{{ else }}

					<div id="cloudstorage_options" style="visibility: hidden">

						<br><p>
							{{$.UI.T "setup.picturesLocation"}}
						</p>
						<select name="storage_sel_image" id="storage_sel_image" style="width:350px;" class="select form-control">
								<option value="nochange" selected>{{$.UI.T "setup.useCloud"}}</option>
								<option value="local">{{$.UI.T "setup.localPictures"}}</option>

						</select>
						<br><p>
							{{$.UI.T "setup.proxyHelp"}}
						</p>
						<select name="storage_sel_proxy" id="storage_sel_proxy" style="width:350px;" class="select form-control">
								<option value="presigned" selected>{{$.UI.T "setup.default"}}</option>
								<option value="proxy">{{$.UI.T "setup.proxyDownloads"}}</option>

						</select>
					</div>
{{ end }}
					

				</div>
			</div>
			
			
			<!-- Step 7 S3 Credentials -->
			<div class="wizard-card wizard-card-overlay" data-cardname="s3credentials">
				<h3 style="display:none">{{$.UI.T "setup.s3Credentials"}}</h3>

				<div class="wizard-input-section">
				
					<div class="form-group">
							<div class="col-sm-8">
{{ if not .S3EnvProvided }}
							  <label for="s3_bucket">{{$.UI.T "setup.bucketName"}}:</label>
								<input type="text" class="form-control" id="s3_bucket" name="s3_bucket" placeholder="{{$.UI.T "setup.bucketName"}}" data-min="1" data-validate="validateMinLength">
							</div><br><br>
							<div class="col-sm-8">
							  <label for="s3_region">{{$.UI.T "setup.regionName"}}:</label>
								<input type="text" class="form-control" id="s3_region" name="s3_region" placeholder="{{$.UI.T "setup.regionName"}}" required data-min="1" data-validate="validateMinLength">
							</div><br><br>
							<div class="col-sm-8">
							  <label for="s3_api">{{$.UI.T "setup.apiKey"}}:</label>
								<input type="text" class="form-control" id="s3_api" name="s3_api" placeholder="{{$.UI.T "setup.apiKey"}}" required data-min="1" data-validate="validateMinLength">
							</div><br><br>
							
							<div class="col-sm-8">
							  <label for="s3_secret">{{$.UI.T "setup.apiKeySecret"}}:</label>
								<input type="text" class="form-control" id="s3_secret" name="s3_secret" placeholder="{{$.UI.T "setup.apiKeySecret"}}" required data-min="1" data-validate="validateMinLength">
							</div><br><br>
							<div class="col-sm-8">
							  <label for="s3_endpoint">{{$.UI.T "setup.endpoint"}}</label>
								<input type="text" class="form-control" id="s3_endpoint" name="s3_endpoint" placeholder="{{$.UI.T "setup.endpointHint"}}">
							<br><br>			  
	  						 <button id="downloadbutton" class="btn btn-light" type="button" onclick="TestAWS(this, true);">
                                {{$.UI.T "setup.testConfiguration"}}
			  				</button>	
{{ else }}
							{{$.UI.T "setup.envCredentials"}}
							<br><br>
	  						 <button id="downloadbutton" class="btn btn-light" type="button" onclick="TestAWS(this, false);">
                                {{$.UI.T "setup.testConfiguration"}}
			  				</button>
			  				<input type="hidden" id="s3_bucket" name="s3_bucket">
			  				<input type="hidden" id="s3_region" name="s3_region" >
			  				<input type="hidden" id="s3_api" name="s3_api">
			  				<input type="hidden" id="s3_secret" name="s3_secret">
			  				<input type="hidden" id="s3_endpoint" name="s3_endpoint">
{{ end }}			
							</div>
						</div>
