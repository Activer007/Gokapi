{{ define "uploadreq" }}{{ template "header" . }}
<div class="row">
    <div class="col">
        <div id="container" class="card" style="width: 80%">
            <div class="card-body">
		<div class="container">
		  <div class="row mb-4">
		    <div class="col">
		    </div>
		    <div class="col text-center">
              <h3 class="card-title mb-0">{{$.UI.T "nav.requests"}}</h3>
		    </div>
		    <div class="col text-end">
		      <button id="button-newfr" class="btn btn-outline-light" onclick="newFileRequest()">
                    <i class="bi bi-plus-circle-fill"></i>
                </button>
		    </div>
		  </div>
		</div>
		
                <br>
                <div class="table-responsive">
                    <table class="table table-dark ">
                        <thead>
                            <tr>
                                <th scope="col">{{$.UI.T "common.name"}}</th>
                                <th scope="col">{{$.UI.T "request.uploadedFiles"}}</th>
                                <th scope="col">{{$.UI.T "request.totalSize"}}</th>
                                <th scope="col">{{$.UI.T "request.lastUpload"}}</th>
                                <th scope="col">{{$.UI.T "common.expiry"}}</th>
{{ if .ActiveUser.HasPermissionListOtherUploads }}
                        <th scope="col">{{$.UI.T "common.user"}}</th>
{{ end }}
                                <th scope="col" class="text-end">{{$.UI.T "common.actions"}}</th>
                            </tr>
                        </thead>
                        <tbody id="filerequesttable">
                        
{{ range $fileRequest := .FileRequests }}
                            <tr id="row-{{ .Id }}" class="no-bottom-border filerequest-item">
		                    <td><a href="{{ $.ServerUrl }}publicUpload?id={{ .Id }}&key={{ .ApiKey }}" target="_blank">{{ .Name }}</a></td>
				    {{ template "uRFileCell" (newFileRequestContext . $.UI) }}
		                    <td>{{ .GetReadableTotalSize }}</td>
            			    <td><span id="cell-lastupdate-{{ .Id }}"></span></td>
				       <script>insertDateWithNegative({{ .LastUpload }}, "cell-lastupdate-{{ .Id }}", t("common.none"));</script>
            			    <td><span id="cell-expiry-{{ .Id }}"></span></td>
				       <script>insertFileRequestExpiry({{ .Expiry }}, "cell-expiry-{{ .Id }}");</script>
		                    
{{ if $.ActiveUser.HasPermissionListOtherUploads }}
		                    <td id="cell-username-{{ .Id }}">{{(index $.UserMap .UserId).Name}}</td>
{{ end }}
		                    <td>
					<div class="btn-toolbar justify-content-end" role="toolbar">
		                    	<div class="btn-group" role="group">
                                {{ template "uRDownloadbutton" (newFileRequestContext . $.UI) }}
                                
                                
                                <button id="copy-{{ .Id }}" type="button" data-clipboard-text="{{ $.ServerUrl }}publicUpload?id={{ .Id }}&key={{ .ApiKey }}" class="copyurl btn btn-outline-light btn-sm" onclick="showToast(1000);" title="{{$.UI.T "common.copyURL"}}"><i class="bi bi-copy"></i></button>
                                
                                <button id="edit-{{ .Id }}" type="button" title="{{$.UI.T "request.edit"}}" class="btn btn-outline-light btn-sm" onclick="editFileRequest('{{ .Id }}', '{{ .Name }}', {{ .MaxFiles }}, {{ .MaxSize }}, {{ .Expiry }}, '{{ .Notes }}')">
		                        	<i class="bi bi-pencil"></i></button>
                                
                                
                                <button id="delete-{{ .Id }}" type="button" class="btn btn-outline-danger btn-sm" onclick="deleteOrShowModal('{{ .Id }}', '{{ .Name }}', {{ .UploadedFiles }})" title="{{$.UI.T "common.delete"}}"><i class="bi bi-trash3"></i></button>
                                	</div>
                                	</div>
                                </td>
                            </tr>
			      <tr id="filelist-{{ .Id }}">
			  <td colspan="7" class="p-0">                      
			<div id="collapse-filelist-{{ .Id }}" class="collapse bg-dark">
			   <div class="p-2">

				    <ul class="list-group list-group-flush">
      {{ range .Files }}
				      <li id="cell-listupload-{{ .Id }}" class="list-group-itemtext-light d-flex align-items-center border-bottom-0  filelist-item ">

					<div class="flex-grow-1 text-truncate">
					  <a href="#" id="cell-name-{{ .Id }}" class="text-decoration-none text-light" onClick="downloadFileWithPresign('{{ .Id }}');">
					    {{ .Name }}
					  </a>
					</div>

					<div class="small me-3 text-nowrap text-light">
					  {{ .Size }} · <span id="cell-date-file-{{.Id}}"></span>
					</div>
					<script>insertFormattedDate({{ .UploadDate }}, "cell-date-file-{{.Id}}");</script>

					<button class="btn btn-outline-light btn-sm"
						 onClick="downloadFileWithPresign('{{ .Id }}');"
                        title="{{$.UI.T "common.download"}}">
					  <i class="bi bi-download"></i>
					</button>
					
					<button id="button-delete-{{ .Id}}"
					   type="button"
                       title="{{$.UI.T "common.delete"}}"
					    {{ if and (ne $.ActiveUser.Id .UserId) (not $.ActiveUser.HasPermissionDeleteOtherUploads) }}
					    	disabled
					    {{ end }}
					   class="btn btn-outline-danger btn-sm"
					   onclick="deleteFileFr('{{ .Id }}', '{{$fileRequest.Id}}')">
					   <i class="bi bi-trash3"></i>
					</button>

				      </li>
				      {{ end }}
				    </ul>

				  </div>
			</div> </td>
			</tr>
{{ end }}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <div id="toastnotification" class="toastnotification" data-default="{{$.UI.T "files.copyToast"}}"></div>
	<div id="toastnotificationUndo" class="toastnotification">
      {{$.UI.T "files.deleted"}} <span id="toastFilename"></span>
       <span id="toastUndoButton" class="toast-undo" onclick="handleUndoFr(this)">{{$.UI.T "common.restore"}}</span>
	</div>
    </div>
</div>
<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
<script>
	var userName = "{{.ActiveUser.Name}}";
	var baseUrl = "{{.ServerUrl}}";
	var canViewOtherRequests = {{.ActiveUser.HasPermissionListOtherUploads}};
	var limitMaxSize = {{.FileRequestMaxSize}};
	var limitMaxFiles = {{.FileRequestMaxFiles}};
	
</script>



{{ template "urequest_modal_confirm" . }}
{{ template "urequest_modal_addedit" . }}
        
{{ template "pagename" "UploadRequest"}}
{{ template "customjs" .}}

{{template "footer" .UI}}
{{ end }}



{{ define "urequest_modal_confirm" }}
	<div class="modal" tabindex="-1" id="deleteModal">
	  <div class="modal-dialog gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
        <h5 class="modal-title">{{$.UI.T "request.deleteTitle"}}</h5>
	      </div>
	      <div class="modal-body">
        <p>{{$.UI.T "request.deleteBefore"}}<span id="deleteModalBodyName" class="fw-bold"></span>{{$.UI.T "request.deleteAfter"}}<br><br>
        {{$.UI.T "request.deleteFilesBefore"}} <span id="deleteModalBodyCount" class="fw-bold"></span> {{$.UI.T "request.deleteFilesAfter"}}</p>
		</div>
	      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.cancel"}}</button>
        <button type="button" id="buttonDelete" class="btn btn-danger">{{$.UI.T "common.delete"}}</button>
	      </div>
	    </div>
	  </div>
	</div>
{{ end }}

{{ define "urequest_modal_addedit" }}

	<div class="modal fade" id="addEditModal" tabindex="-1"  aria-hidden="true">
	  <div class="modal-dialog  modal-lg gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
        <h1 class="modal-title fs-5" id="m_urequestlabel">{{$.UI.T "request.title"}}</h1>
	      </div>
	      <div class="modal-body">
		<div class="input-group mb-3">
	         <!-- Hidden checkbox to have same spacing -->
	     	 <div class="input-group-text">
  			<input type="checkbox" style="visibility: hidden" aria-hidden="true">
		</div>
          <span class="input-group-text modal-samesize-input-filerequest" id="mTitle">{{$.UI.T "request.title"}}</span>
          <input type="text" id="mFriendlyName" class="form-control" placeholder="{{$.UI.T "request.friendlyName"}}" aria-label="{{$.UI.T "request.friendlyName"}}" aria-describedby="mTitle">
		</div>

		<div class="input-group mb-3">
		  <div class="input-group-text">
                <input type="checkbox" id="mc_maxfiles"  aria-label="{{$.UI.T "request.maxFiles"}}" title="{{$.UI.T "request.maxFiles"}}"  data-toggle-target="mi_maxfiles" onchange="handleEditCheckboxChange(this)">
   		 </div>
          <span class="input-group-text modal-samesize-input-filerequest" id="mMaxFiles">{{$.UI.T "request.maxFiles"}}</span>
          <input type="number" min="1" id="mi_maxfiles" onChange="checkMaxNumber(this)" disabled class="form-control" aria-label="{{$.UI.T "request.maxFiles"}}" aria-describedby="mMaxFiles" data-allow-regular-paste>
		</div>

		<div class="input-group mb-3">
		  <div class="input-group-text">
                <input type="checkbox" id="mc_maxsize"  aria-label="{{$.UI.T "request.maxSize"}}" title="{{$.UI.T "request.maxSize"}}"
      			 data-toggle-target="mi_maxsize" onchange="handleEditCheckboxChange(this)">
   		 </div>
          <span class="input-group-text modal-samesize-input-filerequest" id="tMaxSize">{{$.UI.T "request.maxSize"}}</span>
          <input type="number" min="1" id="mi_maxsize"  onChange="checkMaxNumber(this)" disabled class="form-control" aria-label="{{$.UI.T "request.maxSize"}}" aria-describedby="tMaxSize" data-allow-regular-paste>
		  <span class="input-group-text">MB</span>
		</div>
		
		<div class="input-group mb-3">
		  <div class="input-group-text">
                <input id="mc_expiry" type="checkbox" aria-label="{{$.UI.T "common.expiry"}}" title="{{$.UI.T "common.expiry"}}"  data-toggle-target="mi_expiry" data-timestamp="" onchange="handleEditCheckboxChange(this)" >
   		 </div>
          <span class="input-group-text modal-samesize-input-filerequest" id="edit_expdate">{{$.UI.T "common.expiry"}}</span>
          <input type="text" id="mi_expiry" disabled class="form-control" aria-label="{{$.UI.T "common.expiry"}}" aria-describedby="edit_expdate"  data-allow-regular-paste>
		</div>
		
		<div class="input-group mb-3">
	         <!-- Hidden checkbox to have same spacing -->
	     	 <div class="input-group-text">
  			<input type="checkbox" style="visibility: hidden" aria-hidden="true">
		</div>
          <span class="input-group-text modal-samesize-input-filerequest" id="mdNotes">{{$.UI.T "request.notesLabel"}}</span>
          <input type="text" id="mNotes" class="form-control" placeholder="{{$.UI.T "request.notesHint"}}" aria-label="{{$.UI.T "request.notesLabel"}}" aria-describedby="mdNotes">
		</div>
	      </div>
	      <input type="hidden" id="freqId" value="" />
{{ if .EndToEndEncryption }}
<div class="callout callout-info">
  {{$.UI.T "request.plaintextNotice"}}
</div>
{{ end }}
	      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light"  aria-label="{{$.UI.T "common.close"}}" data-bs-dismiss="modal">{{$.UI.T "common.close"}}</button>
        <button type="button" class="btn btn-primary" data-fileid="" id="b_fr_save" onclick="">{{$.UI.T "common.save"}}</button>
	      </div>
	    </div>
	  </div>
	</div>

{{ end }}


{{ define "uRDownloadbutton" }}
	{{ if eq .UploadedFiles 0 }}
        <button id="download-{{ .Id }}" type="button" class="btn btn-outline-light btn-sm disabled" title="{{$.UI.T "request.downloadAll"}}"><i class="bi bi-download"></i></button>
	{{ else }}
		{{ if eq .UploadedFiles 1 }}
            <button id="download-{{ .Id }}" type="button" class="btn btn-outline-light btn-sm" onclick="downloadFileWithPresign('{{ (index .FileIdList 0) }}');" title="{{$.UI.T "request.downloadAll"}}"><i class="bi bi-download"></i></button>
		{{ else }}
            <button id="download-{{ .Id }}" type="button" class="btn btn-outline-light btn-sm" onclick="downloadFilesZipWithPresign('{{ .GetFilesAsString }}', '{{ .Name }}');" title="{{$.UI.T "request.downloadAll"}}"><i class="bi bi-download"></i></button>
	{{ end }}
	{{ end }}
{{ end }}


{{ define "uRFileCell" }}
	<td>
    <span id="totalFiles-fr-{{.Id}}" title="{{$.UI.T "request.uploadedFiles"}}">{{ .UploadedFiles }}</span>{{ if ne .ReservedUploads 0 }}<span title="{{$.UI.T "request.activeUploads"}}">+{{.ReservedUploads}}</span>{{end}}{{ if ne .MaxFiles 0 }} / <span title="{{$.UI.T "request.fileLimit"}}">{{ .MaxFiles }}</span>{{end}}
	{{ if gt .UploadedFiles 0 }}
	 <button
		  class="btn btn-sm btn-link text-light p-0 collapse-toggle"
		  data-bs-toggle="collapse"
		  data-bs-target="#collapse-filelist-{{ .Id }}"
		  aria-expanded="false"
          title = "{{$.UI.T "request.expand"}}"
		  aria-controls="collapse-filelist-{{ .Id }}">
		  <i class="bi bi-chevron-down"></i>
		</button>
	{{end}}
	</td> 
{{ end }}
