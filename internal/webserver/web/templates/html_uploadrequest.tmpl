{{ define "uploadreq" }}{{ template "header" . }}
<section id="container" class="collections-workspace" aria-labelledby="collectionsTitle">
  <div class="page-heading">
    <div><h1 id="collectionsTitle">{{.UI.T "nav.requests"}}</h1><p>{{.UI.T "request.workspaceHelp"}}</p></div>
    <button id="button-newfr" type="button" class="btn btn-primary primary-upload" onclick="newFileRequest()"><i class="bi bi-plus-lg" aria-hidden="true"></i>{{.UI.T "request.new"}}</button>
  </div>
  <div class="collections-section-heading"><h2>{{.UI.T "request.links"}} <span id="requestCount" class="file-count">{{len .FileRequests}}</span></h2></div>
  <div id="requestEmpty" class="collection-empty" {{if .FileRequests}}hidden{{end}}>
    <i class="bi bi-inbox" aria-hidden="true"></i><h3>{{.UI.T "request.emptyTitle"}}</h3><p>{{.UI.T "request.emptyHelp"}}</p>
  </div>
  <div id="requestTableWrap" class="table-responsive collections-table" {{if not .FileRequests}}hidden{{end}}>
                    <table class="table table-dark ">
                        <thead>
                            <tr>
                                <th scope="col">{{$.UI.T "common.name"}}</th>
                                <th scope="col">{{$.UI.T "request.uploadedFiles"}}</th>
                                <th scope="col">{{$.UI.T "request.totalSize"}}</th>
                                <th scope="col">{{$.UI.T "request.lastUpload"}}</th>
                                <th scope="col">{{$.UI.T "common.expiry"}}</th>
{{ if .ActiveUser.HasPermissionListOtherUploads }}
                        <th scope="col">{{$.UI.T "common.user"}}</th>
{{ end }}
                                <th scope="col" class="text-end">{{$.UI.T "common.actions"}}</th>
                            </tr>
                        </thead>
                        <tbody id="filerequesttable">
                        
{{ range $fileRequest := .FileRequests }}
                            <tr id="row-{{ .Id }}" class="no-bottom-border filerequest-item">
		                    <td><a href="{{ $.ServerUrl }}r/{{ .ApiKey }}" target="_blank">{{ .Name }}</a></td>
				    {{ template "uRFileCell" (newFileRequestContext . $.UI) }}
		                    <td>{{ .GetReadableTotalSize }}</td>
            			    <td><span id="cell-lastupdate-{{ .Id }}"></span></td>
				       <script>insertDateWithNegative({{ .LastUpload }}, "cell-lastupdate-{{ .Id }}", t("common.none"));</script>
            			    <td><span id="cell-expiry-{{ .Id }}"></span></td>
				       <script>insertFileRequestExpiry({{ .Expiry }}, "cell-expiry-{{ .Id }}");</script>
		                    
{{ if $.ActiveUser.HasPermissionListOtherUploads }}
		                    <td id="cell-username-{{ .Id }}">{{(index $.UserMap .UserId).Name}}</td>
{{ end }}
		                    <td>
					<div class="btn-toolbar justify-content-end" role="toolbar">
		                    	<div class="btn-group" role="group">
                                {{ template "uRDownloadbutton" (newFileRequestContext . $.UI) }}
                                
                                
                                <button id="copy-{{ .Id }}" type="button" data-clipboard-text="{{ $.ServerUrl }}r/{{ .ApiKey }}" class="copyurl btn btn-outline-light btn-sm" title="{{$.UI.T "common.copyURL"}}"><i class="bi bi-copy"></i></button>
                                
                                <button id="edit-{{ .Id }}" type="button" title="{{$.UI.T "request.edit"}}" class="btn btn-outline-light btn-sm" onclick="editFileRequest('{{ .Id }}', '{{ .Name }}', {{ .MaxFiles }}, {{ .MaxSize }}, {{ .Expiry }}, '{{ .Notes }}', {{ .AllowedDownloads }})">
		                        	<i class="bi bi-pencil"></i></button>
                                
                                
                                <button id="delete-{{ .Id }}" type="button" class="btn btn-outline-danger btn-sm" onclick="deleteOrShowModal('{{ .Id }}', '{{ .Name }}', {{ .UploadedFiles }})" title="{{$.UI.T "common.delete"}}"><i class="bi bi-trash3"></i></button>
                                	</div>
                                	</div>
                                </td>
                            </tr>
			      <tr id="filelist-{{ .Id }}">
			  <td colspan="{{if $.ActiveUser.HasPermissionListOtherUploads}}7{{else}}6{{end}}" class="p-0">
			<div id="collapse-filelist-{{ .Id }}" class="collapse collection-files">
			   <div class="p-2">

				    <ul class="list-group list-group-flush">
      {{ range .Files }}
				      <li id="cell-listupload-{{ .Id }}" data-request-id="{{$fileRequest.Id}}" class="list-group-itemtext-light d-flex align-items-center border-bottom-0  filelist-item ">

					<div class="flex-grow-1 collection-file-name">
					  <a href="#" id="cell-name-{{ .Id }}" data-collection-download class="text-decoration-none text-light" onClick="downloadFileWithPresign('{{ .Id }}'); return false;">
					    {{ .Name }}
					  </a>
					</div>

					<div class="small me-3 text-nowrap text-light">
					  {{ .Size }} · <span id="cell-date-file-{{.Id}}"></span>
                          <span class="d-block" title="{{$.UI.T "files.remaining"}}">{{$.UI.T "files.remaining"}}: <span id="cell-downloadsRemaining-{{.Id}}" data-remaining="{{if .UnlimitedDownloads}}-1{{else}}{{.DownloadsRemaining}}{{end}}">{{if .UnlimitedDownloads}}{{$.UI.T "common.unlimited"}}{{else}}{{.DownloadsRemaining}}{{end}}</span> <span id="cell-expired-file-{{.Id}}" {{if or .UnlimitedDownloads (gt .DownloadsRemaining 0)}}hidden{{end}}>· {{$.UI.T "common.expired"}}</span></span>
					</div>
					<script>insertFormattedDate({{ .UploadDate }}, "cell-date-file-{{.Id}}");</script>

					<button class="btn btn-outline-light btn-sm" data-collection-download
						 onClick="downloadFileWithPresign('{{ .Id }}');"
                        title="{{$.UI.T "common.download"}}">
					  <i class="bi bi-download"></i>
					</button>
					
					<button id="button-delete-{{ .Id}}"
					   type="button"
                       title="{{$.UI.T "common.delete"}}"
					    {{ if and (ne $.ActiveUser.Id .UserId) (not $.ActiveUser.HasPermissionDeleteOtherUploads) }}
					    	disabled
					    {{ end }}
					   class="btn btn-outline-danger btn-sm"
					   onclick="deleteFileFr('{{ .Id }}', '{{$fileRequest.Id}}')">
					   <i class="bi bi-trash3"></i>
					</button>

				      </li>
				      {{ end }}
				    </ul>

				  </div>
			</div> </td>
			</tr>
{{ end }}
                        </tbody>
                    </table>
  </div>
</section>
    <div id="toastnotification" class="toastnotification" role="status" aria-live="polite" aria-atomic="true" data-default="{{$.UI.T "files.copyToast"}}"></div>
	<div id="toastnotificationUndo" class="toastnotification">
      {{$.UI.T "files.deleted"}} <span id="toastFilename"></span>
       <button type="button" id="toastUndoButton" class="toast-undo btn btn-sm btn-outline-light" onclick="handleUndoFr(this)">{{$.UI.T "common.restore"}}</button>
	</div>
<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
<script>
	var userName = "{{.ActiveUser.Name}}";
	var baseUrl = "{{.ServerUrl}}";
	var canViewOtherRequests = {{.ActiveUser.HasPermissionListOtherUploads}};
	var limitMaxSize = {{.FileRequestMaxSize}};
	var limitMaxFiles = {{.FileRequestMaxFiles}};
    document.querySelectorAll('.filerequest-item').forEach(prepareFileRequestRow);
    document.querySelectorAll('[data-remaining="0"]').forEach(cell => expireCollectionFile(cell.id.slice('cell-downloadsRemaining-'.length)));
    updateFileRequestEmptyState();
	registerCollectionChanges();
	
</script>



{{ template "urequest_modal_confirm" . }}
{{ template "urequest_modal_addedit" . }}
        
{{ template "pagename" "UploadRequest"}}
{{ template "customjs" .}}

{{template "footer" .UI}}
{{ end }}



{{ define "urequest_modal_confirm" }}
	<div class="modal" tabindex="-1" id="deleteModal" aria-labelledby="requestDeleteTitle">
	  <div class="modal-dialog gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
        <h2 id="requestDeleteTitle" class="modal-title fs-5">{{$.UI.T "request.deleteTitle"}}</h2>
	      </div>
	      <div class="modal-body">
        <p>{{$.UI.T "request.deleteBefore"}}<span id="deleteModalBodyName" class="fw-bold"></span>{{$.UI.T "request.deleteAfter"}}<br><br>
        {{$.UI.T "request.deleteFilesBefore"}} <span id="deleteModalBodyCount" class="fw-bold"></span> {{$.UI.T "request.deleteFilesAfter"}}</p>
		</div>
	      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.cancel"}}</button>
        <button type="button" id="buttonDelete" class="btn btn-danger">{{$.UI.T "common.delete"}}</button>
	      </div>
	    </div>
	  </div>
	</div>
{{ end }}

{{ define "urequest_modal_addedit" }}

	<div class="modal fade" id="addEditModal" tabindex="-1" aria-labelledby="m_urequestlabel" aria-hidden="true">
	  <div class="modal-dialog  modal-lg gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
        <h1 class="modal-title fs-5" id="m_urequestlabel">{{$.UI.T "request.title"}}</h1>
	      </div>
	      <div class="modal-body text-start settings-form">
        <div class="mb-3">
          <label class="form-label" for="mFriendlyName">{{$.UI.T "request.title"}}</label>
          <input type="text" id="mFriendlyName" class="form-control" placeholder="{{$.UI.T "request.friendlyName"}}">
        </div>
        <p class="form-text text-muted" id="requestLimitsHelp">{{$.UI.T "request.limitHelp"}}</p>
        <div class="settings-field mb-3">
          <div class="form-check mb-2">
            <input class="form-check-input" id="mc_maxfiles" type="checkbox" data-toggle-target="mi_maxfiles" onchange="handleEditCheckboxChange(this)">
            <label class="form-check-label" for="mc_maxfiles">{{$.UI.T "request.maxFiles"}}</label>
          </div>
          <div class="input-group">
            <input type="number" id="mi_maxfiles" min="1" onchange="checkMaxNumber(this)" disabled class="form-control" aria-label="{{$.UI.T "request.maxFiles"}}" aria-describedby="requestLimitsHelp" data-allow-regular-paste>
          </div>
        </div>
        <div class="settings-field mb-3">
          <div class="form-check mb-2">
            <input class="form-check-input" id="mc_maxsize" type="checkbox" data-toggle-target="mi_maxsize" onchange="handleEditCheckboxChange(this)">
            <label class="form-check-label" for="mc_maxsize">{{$.UI.T "request.maxSize"}}</label>
          </div>
          <div class="input-group">
            <input type="number" id="mi_maxsize" min="1" onchange="checkMaxNumber(this)" disabled class="form-control" aria-label="{{$.UI.T "request.maxSize"}}" aria-describedby="requestLimitsHelp" data-allow-regular-paste>
            <span class="input-group-text">MB</span>
          </div>
        </div>
        <div class="settings-field mb-3">
          <div class="form-check mb-2">
            <input class="form-check-input" id="mc_expiry" type="checkbox" data-toggle-target="mi_expiry" onchange="handleEditCheckboxChange(this)">
            <label class="form-check-label" for="mc_expiry">{{$.UI.T "common.expiry"}}</label>
          </div>
          <div class="input-group">
            <input type="text" id="mi_expiry"  disabled class="form-control" aria-label="{{$.UI.T "common.expiry"}}" aria-describedby="requestLimitsHelp" data-allow-regular-paste>
          </div>
        </div>
        <div class="settings-field mb-3">
          <label class="form-label" for="mi_downloads">{{$.UI.T "request.allowedDownloads"}}</label>
          <input type="number" id="mi_downloads" min="1" max="10" step="1" value="1" required class="form-control" aria-describedby="requestDownloadsHelp" data-allow-regular-paste>
          <div id="legacyDownloadsOption" class="form-check mt-2" hidden>
            <input class="form-check-input" id="mc_keepdownloads" type="checkbox" onchange="handleRequestDownloadPolicyChange()">
            <label class="form-check-label" for="mc_keepdownloads">{{$.UI.T "request.keepLegacyDownloads"}}</label>
          </div>
          <p class="form-text text-muted" id="requestDownloadsHelp">{{$.UI.T "request.downloadsHelp"}}</p>
        </div>
        <div class="mb-2">
          <label class="form-label" for="mNotes">{{$.UI.T "request.notesLabel"}}</label>
          <textarea id="mNotes" rows="2" class="form-control" placeholder="{{$.UI.T "request.notesHint"}}" aria-describedby="requestNotesHelp"></textarea>
          <p class="form-text text-muted" id="requestNotesHelp">{{$.UI.T "request.notesPublic"}}</p>
        </div>
      </div>
      <input type="hidden" id="freqId" value="" />
{{ if .EndToEndEncryption }}
<div class="callout callout-info">
  {{$.UI.T "request.plaintextNotice"}}
</div>
{{ end }}
	      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light"  aria-label="{{$.UI.T "common.close"}}" data-bs-dismiss="modal">{{$.UI.T "common.close"}}</button>
        <button type="button" class="btn btn-primary" data-fileid="" id="b_fr_save" onclick="">{{$.UI.T "common.save"}}</button>
	      </div>
	    </div>
	  </div>
	</div>

{{ end }}


{{ define "uRDownloadbutton" }}
<button id="download-{{ .Id }}" type="button" class="btn btn-outline-light btn-sm" {{if eq .UploadedFiles 0}}disabled{{end}} data-file-ids="{{.GetFilesAsString}}" data-record-name="{{.Name}}" title="{{.UI.T "request.downloadAll"}}"><i class="bi bi-download" aria-hidden="true"></i></button>
{{ end }}

{{ define "uRFileCell" }}
	<td>
    <span id="totalFiles-fr-{{.Id}}" title="{{$.UI.T "request.uploadedFiles"}}">{{ .UploadedFiles }}</span>{{ if ne .ReservedUploads 0 }}<span title="{{$.UI.T "request.activeUploads"}}">+{{.ReservedUploads}}</span>{{end}}{{ if ne .MaxFiles 0 }} / <span title="{{$.UI.T "request.fileLimit"}}">{{ .MaxFiles }}</span>{{end}}
	{{ if gt .UploadedFiles 0 }}
	 <button
		  class="btn btn-sm btn-link text-light p-0 collapse-toggle"
		  data-bs-toggle="collapse"
		  data-bs-target="#collapse-filelist-{{ .Id }}"
		  aria-expanded="false"
          title = "{{$.UI.T "request.expand"}}"
		  aria-controls="collapse-filelist-{{ .Id }}">
		  <i class="bi bi-chevron-down"></i>
		</button>
	{{end}}
	</td> 
{{ end }}
