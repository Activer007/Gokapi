{{ define "logs" }}{{ template "header" . }}

<section class="status-workspace" aria-labelledby="statusTitle">
<div class="page-heading"><div><h1 id="statusTitle">{{$.UI.T "nav.status"}}</h1><p>{{$.UI.T "status.workspaceHelp"}}</p></div></div>

    <div class="status-metrics">
        <div class="status-metric">
            <div class="card stat-card h-100">
                <div class="card-body p-3">
                    <div class="stat-label">{{$.UI.T "status.uptime"}}</div>
                    <div class="h5 mb-0 text-light"><span id="uptime"></span></div>
                </div>
            </div>
        </div>

        <div class="status-metric">
            <div class="card stat-card h-100">
                <div class="card-body p-3">
                    <div class="stat-label">{{$.UI.T "status.cpu"}}</div>
                    <div class="h5 mb-2 text-light" id="labelCpu">{{ .CpuLoad}}%</div>
                    <div class="progress progress-stat">
                        <div class="progress-bar" id="barCpu" style="width: {{ .CpuLoad}}%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="status-metric">
            <div class="card stat-card h-100">
                <div class="card-body p-3">
                    <div class="stat-label">{{$.UI.T "status.memory"}}</div>
                    <div class="h5 mb-2 text-light text-nowrap"><span id="usedMemory"></span> / <span id="totalMemory"></span> <span id="memoryUnit" class="small opacity-50"></span></div>
                    <div class="progress progress-stat">
                        <div class="progress-bar" id="barMemory" style="width: {{.MemoryUsagePercent}}%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="status-metric">
            <div class="card stat-card h-100">
                <div class="card-body p-3">
                    <div class="stat-label">{{$.UI.T "status.disk"}}</div>
                    <div class="h5 mb-2 text-light text-nowrap"><span id="usedDisk"></span> / <span id="totalDisk"></span> <span id="diskUnit" class="small opacity-50"></span></div>
                    <div class="progress progress-stat">
                        <div class="progress-bar" id="barDisk" style="width: {{.DiskUsagePercent}}%"></div>
                    </div>
                </div>
            </div>
        </div>

	<div class="status-metric">
		    <div class="card stat-card h-100">
		        <div class="card-body p-3" id="cardTraffic">
                    <div class="stat-label">{{$.UI.T "status.served"}}</div>
		            <div class="h5 mb-0 text-light" >
		                <span id="totalTraffic"></span>
		                <span id="totalTrafficUnit" class="small opacity-50"></span>
		            </div>
		        </div>
		    </div>
		</div>

        <div class="status-metric">
            <div class="card stat-card h-100">
                <div class="card-body p-3">
                    <div class="stat-label">{{$.UI.T "request.uploadedFiles"}}</div>
                    <div class="h5 mb-0 text-light"><span id="labelActiveFiles"> {{ .TotalFiles }}</span> <span class="small opacity-50">{{$.UI.T "status.total"}}</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="status-log-panel">
        <div class="status-log-heading">
            <div class="d-flex align-items-center">
                <h2 class="mb-0">{{$.UI.T "status.logs"}}</h2>
            </div>
        </div>

        <div class="status-log-content">
            <textarea
                class="form-control font-monospace"
                id="logviewer" placeholder="{{$.UI.T "status.noEvents"}}" aria-label="{{$.UI.T "status.logs"}}"
                rows="16"
                readonly
                >
                    {{$.UI.T "common.loading"}}
            </textarea>
        </div>

        <div class="status-log-tools">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <label for="logFilter" class="input-group-text">{{$.UI.T "status.filter"}}</label>
                        <select id="logFilter" class="form-select" onchange="filterLogs(this.value)">
                            <option value="all">{{$.UI.T "status.allEvents"}}</option>
                            <option value="warning">{{$.UI.T "status.warning"}}</option>
                            <option value="auth">{{$.UI.T "status.auth"}}</option>
                            <option value="upload">{{$.UI.T "users.uploads"}}</option>
                            <option value="edit">{{$.UI.T "status.modifications"}}</option>
                            <option value="download">{{$.UI.T "files.downloads"}}</option>
                            <option value="info">{{$.UI.T "status.info"}}</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-2"></div>

                <div class="col-md-5">
                    <div class="d-flex flex-wrap gap-2 justify-content-md-end">
{{ if or (eq .ActiveUser.UserLevel 0) (eq .ActiveUser.UserLevel 1) }}
                <button class="btn btn-sm btn-outline-light text-nowrap" title="{{$.UI.T "status.resetTrafficHint"}}" onclick="resetTrafficStat(this)">
                                {{$.UI.T "status.resetTraffic"}}
                            </button>

                            <div class="vr bg-secondary mx-2 opacity-50"></div>


                        <select id="deleteLogsSel" aria-label="{{$.UI.T "status.deleteLogs"}}" class="form-select form-select-sm w-auto">
                            <option value="none">{{$.UI.T "status.deleteLogs"}}</option>
                            <option value="30">{{$.UI.T "status.older30"}}</option>
                            <option value="14">{{$.UI.T "status.older14"}}</option>
                            <option value="7">{{$.UI.T "status.older7"}}</option>
                            <option value="2">{{$.UI.T "status.older2"}}</option>
                            <option value="all">{{$.UI.T "status.deleteAll"}}</option>
                        </select>
                        <button class="btn btn-sm btn-outline-light px-3" onclick="deleteLogs(this)">{{$.UI.T "status.execute"}}</button>
{{ end }}
                    </div>
                </div>
            </div>
        </div>
    </div>
<p id="statusActionResult" class="status-action-result" role="status" aria-live="polite"></p>
</section>
<div class="modal fade" id="statusActionModal" tabindex="-1" aria-labelledby="statusActionTitle" aria-describedby="statusActionHelp" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
    <div class="modal-header"><h2 id="statusActionTitle" class="modal-title fs-5"></h2></div>
    <div class="modal-body"><p id="statusActionHelp"></p><p id="statusActionError" class="text-danger mb-0" role="alert"></p></div>
    <div class="modal-footer"><button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.cancel"}}</button><button id="statusActionConfirm" type="button" class="btn btn-danger">{{$.UI.T "common.confirm"}}</button></div>
  </div></div>
</div>

<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
<script>


    const POLL_INTERVAL_S = 10;

    var logContent = '';
    var lastLogUpdate = 0;
    var currentUptime = {{.Uptime}};

    setPercentageBar("barCpu", {{ .CpuLoad}});
    setPercentageBar("barDisk", {{ .DiskUsage}}, {{.DiskTotal}});
    setPercentageBar("barMemory", {{.MemoryUsage}}, {{.MemoryTotal}});
    setMemoryUsage({{.MemoryUsage}}, {{.MemoryTotal}});
    setDiskUsage({{.DiskUsage}}, {{.DiskTotal}});
    setTrafficInfo({{.TotalTraffic}}, {{.TrafficSince}});
    document.getElementById('uptime').innerText = formatDuration(currentUptime);

    addUptime();
    pollInfo();

</script>

{{ template "pagename" "LogOverview"}}
{{ template "customjs" .}}
{{template "footer" .UI}}
{{ end }}
