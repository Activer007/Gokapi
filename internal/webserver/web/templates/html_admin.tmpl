{{ define "admin" }}{{ template "header" . }}

      <section id="container" class="file-workspace" aria-labelledby="workspaceTitle">
        <div class="page-heading">
          <div><h1 id="workspaceTitle">{{$.UI.T "files.yourFiles"}}</h1><p>{{$.UI.T "files.workspaceHelp"}}</p></div>
          <button id="selectUploadFiles" type="button" class="btn btn-primary primary-upload" {{if .EndToEndEncryption}}disabled{{end}} onclick="chooseUploadFiles()"><i class="bi bi-upload" aria-hidden="true"></i>{{$.UI.T "nav.upload"}}</button>
        </div>

			<form action="./uploadChunk" class="dropzone upload-box text-center w-100" id="uploaddropzone">
				<div class="dz-message">
                  <img class="upload-brand-art" src="./assets/brand/share-folder-v1.png" width="240" height="160" alt="" aria-hidden="true">
                  <div class="upload-prompt">
{{ if .EndToEndEncryption }}
                    <p id="uploadBoxTitle" class="mb-2 fs-5">{{$.UI.T "common.wait"}}</p>
                    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">{{$.UI.T "files.loadingE2E"}}</p>
{{ else }}
                    <p id="uploadBoxTitle" class="mb-2 fs-5">{{$.UI.T "request.drop"}}</p>
                    <p id="uploadBoxSubtitle" class="mb-0 opacity-75">{{$.UI.T "files.selectHint"}}</p>
{{ end }}
                  </div>
                </div>
			</form>

		<div id="uploadstatus" class="container uploads-container">
		</div>		

		<details id="uploadSettings" class="upload-settings">
          <summary><span id="uploadSummary" class="upload-summary" role="status" aria-live="polite"></span><span class="upload-settings-action">{{$.UI.T "files.adjustRules"}} <i class="bi bi-chevron-down" aria-hidden="true"></i></span></summary>
          <p class="upload-settings-help">{{$.UI.T "files.rulesHelp"}}</p>
          <div class="upload-options-grid">

		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-arrow-down-circle upload-option-icon"></i>
                <span class="upload-option-label">{{$.UI.T "files.downloadLimit"}}</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enableDownloadLimit" id="enableDownloadLimit"
		               onchange="checkBoxChanged(this, 'allowedDownloads')" checked
                       aria-label="{{$.UI.T "files.enableDownloads"}}">
		      </div>
		    </div>
		    <div class="input-group upload-option-input-group">
		      <input type="number" class="form-control admin-input" value="1"
		             name="allowedDownloads" id="allowedDownloads" min="1" aria-label="{{$.UI.T "files.downloadLimit"}}"
		             style="text-align: right;" data-allow-regular-paste>
              <span class="input-group-text upload-option-suffix">{{$.UI.T "files.downloads"}}</span>
		    </div>
		  </div>

		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-calendar-x upload-option-icon"></i>
                <span class="upload-option-label">{{$.UI.T "common.expiry"}}</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enableTimeLimit" id="enableTimeLimit"
		               onchange="checkBoxChanged(this, 'expiryDays')" checked
                       aria-label="{{$.UI.T "files.enableTime"}}">
		      </div>
		    </div>
		    <div class="input-group upload-option-input-group">
		      <input type="number" class="form-control admin-input" value="14"
		             name="expiryDays" id="expiryDays" min="1" aria-label="{{$.UI.T "common.expiry"}}" max="100000"
		             style="text-align: right;" data-allow-regular-paste>
              <span class="input-group-text upload-option-suffix">{{$.UI.T "files.days"}}</span>
		    </div>
		  </div>

		  <div class="upload-option-card">
		    <div class="upload-option-header">
		      <div class="d-flex align-items-center gap-2">
		        <i class="bi bi-key upload-option-icon"></i>
                <span class="upload-option-label">{{$.UI.T "common.password"}}</span>
		      </div>
		      <div class="form-check form-switch mb-0">
		        <input class="form-check-input upload-option-toggle" type="checkbox" role="switch"
		               name="enablePassword" id="enablePassword"
		               onchange="checkBoxChanged(this, 'password')"
                       aria-label="{{$.UI.T "files.enablePassword"}}">
		      </div>
		    </div>
		    <input class="form-control admin-input upload-option-input-group" value=""
                   name="password" id="password" aria-label="{{$.UI.T "common.password"}}" placeholder="{{$.UI.T "files.noPassword"}}" disabled
		           data-allow-regular-paste>
		  </div>

		</div>
</details>
<div id="errordiv" class="alert alert-danger" style="display:none">
  <span id="errormessage" ></span>
</div>
		<div class="files-toolbar"><h2 class="files-heading">{{$.UI.T "files.allFiles"}} <span id="fileCount" class="file-count"></span></h2><div class="files-search"><div id="fileSearch"></div><button type="button" id="clearFileSearch" class="btn btn-link" hidden onclick="clearFileSearch()">{{$.UI.T "files.clearSearch"}}</button></div></div>
		<div class="file-table-container">
			<table id="maintable" class="table table-dark">
				<thead>
					<tr>
                        <th scope="col" style="text-align: center;">{{$.UI.T "common.filename"}}</th>
                        <th scope="col" style="text-align: center;">{{$.UI.T "common.size"}}</th>
                        <th scope="col" style="text-align: center;">{{$.UI.T "files.remaining"}}</th>
                        <th scope="col" style="text-align: center;">{{$.UI.T "files.storedUntil"}}</th>
                        <th scope="col" style="text-align: center;">{{$.UI.T "files.downloads"}}</th>
						<th scope="col" style="text-align: center;">ID</th>
                        <th scope="col" style="text-align: center; min-width:11em;">{{$.UI.T "common.actions"}}</th>
					</tr>
				</thead>
				<tbody id="downloadtable">
{{ range .Items }}
	{{ if not (or .IsPendingDeletion .IsFileRequest) }}
		{{ if  or (gt .ExpireAt $.TimeNow) (.UnlimitedTime) }}
			{{ if or (gt .DownloadsRemaining 0) (.UnlimitedDownloads) }}
					<tr id="row-{{ .Id }}">
						<td id="cell-name-{{ .Id }}">{{ .Name }}</td>
						<td data-order="{{ .SizeBytes }}">{{ .Size }}</td>
				{{ if .UnlimitedDownloads }}
                        <td>{{$.UI.T "common.unlimited"}}</td>
				{{ else }}
						<td id="cell-downloadsRemaining-{{ .Id }}">{{ .DownloadsRemaining }}</td>
				{{ end }}
				{{ if .UnlimitedTime }}
                        <td>{{$.UI.T "common.unlimited"}}</td>
				{{ else }}
						<td><span id="cell-expireatstring-{{ .Id }}"></span></td>
						 <script>insertFormattedDate({{ .ExpireAt }}, "cell-expireatstring-{{ .Id }}");</script>
				{{ end }}
						<td id="cell-downloads-{{ .Id }}">{{ .DownloadCount }}</td>
                        <td><a id="url-href-{{ .Id }}" target="_blank" href="{{ .UrlDownload }}">{{ .Id }}</a>{{ if .IsPasswordProtected }}  <i title="{{$.UI.T "files.passwordProtected"}}" class="bi bi-key"></i>{{ end }}</td>
						<td>
						<div class="btn-toolbar justify-content-end" role="toolbar" >
						  <div class="btn-group me-2" role="group">
						     {{ template "admin_button_copyurl" (newAdminButtonContext . $.ActiveUser $.UI)}}
						     {{ template "admin_button_share" (newAdminButtonContext . $.ActiveUser $.UI)}}
						  </div>
						  <div class="btn-group" role="group">
						     {{ template "admin_button_download" (newAdminButtonContext . $.ActiveUser $.UI) }}
						     {{ template "admin_button_edit" (newAdminButtonContext . $.ActiveUser $.UI) }}
						     {{ template "admin_button_delete" (newAdminButtonContext . $.ActiveUser $.UI) }}
						 </div>
						</div></td>
					</tr>
			{{ end }}
		{{ end }}
	{{ end }}
{{ end }}
				</tbody>
			</table>
		      </div>
</section>

	{{ template "admin_modal_edit" . }}

    <div id="toastnotification" class="toastnotification" role="status" aria-live="polite" aria-atomic="true" data-default="{{$.UI.T "files.copyToast"}}"></div>
	<div id="toastnotificationUndo" class="toastnotification" role="status">
      {{$.UI.T "files.deleted"}} <span id="toastFilename"></span>
       <button type="button" id="toastUndoButton" class="toast-undo btn btn-sm btn-outline-light" onclick="handleUndo(this)">{{$.UI.T "common.restore"}}</button>
	</div>
	<div id="toastDeprecation" class="toastnotification toastdeprecation">
      {{$.UI.T "files.deprecated"}}
	</div>
	<div id="qroverlay">
	  <div id="qrcode"></div>
	</div>

	<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
	<script>

	initDropzone();

	Dropzone.options.uploaddropzone["maxFilesize"] = {{ .MaxFileSize }};
	Dropzone.options.uploaddropzone["timeout"] = 1200000;
	Dropzone.options.uploaddropzone["chunking"] = true;
	Dropzone.options.uploaddropzone["chunkSize"] = {{ .ChunkSize }} * 1024 * 1024;
	Dropzone.options.uploaddropzone["parallelUploads"] = 1;
	Dropzone.options.uploaddropzone["parallelChunkUploads"] = {{.MaxParallelUploads}};
	Dropzone.options.uploaddropzone["forceChunking"] = true;
	Dropzone.options.uploaddropzone["retryChunksLimit"] = 3;
	Dropzone.options.uploaddropzone["retryChunks"] = true;
	Dropzone.options.uploaddropzone["previewsContainer"] = false;

	$(document).ready(function () {

	    document.querySelectorAll('#downloadtable tr').forEach(prepareFileActions);
	    $('#maintable').DataTable({
	    "responsive": true,
	    "order": [], // disables initial sorting
	    "columnDefs": [ {
		"targets": 6,
		"orderable": false
		} ],
	    "paging": false,
        "info": false, // The toolbar already displays total and filtered counts.
        "initComplete": function () { initFileTable(this.api()); },
        "drawCallback": function () { updateFileCount(this.api()); },
	    "language": {
	      ...tableLanguage(),
	      "info": t("files.tableCount"),
	      "emptyTable": t("files.empty"),
	      "infoEmpty": "",
	    }
	    });
	});

	registerChangeHandler();

	var canReplaceOwnFiles = {{.ActiveUser.HasPermissionReplace}};
	setUploadDefaults();
	initUploadSummary();

{{ if .ShowDeprecationNotice }}
	showDeprecationNotice();
{{ end }}

	</script>
        <script src="./js/min/uuid.min.js"></script>

{{ if .EndToEndEncryption }}
        <script src="./js/min/wasm_exec.min.js"></script>
	<script src="./js/min/end2end_admin.min.{{ template "js_e2eversion"}}.js"></script>
	<script>
	{{ if .IncludeFilename }}
		const IncludeFilename = true;
	{{ else }}
		const IncludeFilename = false;
	{{ end }}
		isE2EEnabled = true;

		Blob.prototype.arrayBuffer ??= function() {
		    return new Response(this).arrayBuffer()
		}

		checkIfE2EKeyIsSet();
	</script>
{{ end }}

{{ template "pagename" "FileRequest"}}
{{ template "customjs" .}}

{{template "footer" .UI}}
{{ end }}

{{ define "admin_button_download" }}
			<button
			    type="button"
                title="{{$.UI.T "common.download"}}"
			    class="btn btn-outline-light btn-sm {{if .CurrentFile.RequiresClientSideDecryption}}disabled{{end}}"
			    onclick="downloadFileWithPresign('{{.CurrentFile.Id }}');">
		   	    <i class="bi bi-download"></i>
			</button>

{{ end }}

{{ define "admin_button_edit" }}
			<button
			    type="button"
                title="{{$.UI.T "common.edit"}}"
			    {{ if and (ne .ActiveUser.Id .CurrentFile.UploaderId) (not .ActiveUser.HasPermissionEditOtherUploads) }}
			    	disabled
			    {{ end }}
			    class="btn btn-outline-light btn-sm"
			    onclick="showEditModal('{{.CurrentFile.Name }}',
			    	'{{.CurrentFile.Id}}', {{.CurrentFile.DownloadsRemaining }},
			    	 {{.CurrentFile.ExpireAt }}, {{.CurrentFile.IsPasswordProtected}},
			    	 {{.CurrentFile.UnlimitedDownloads }}, {{.CurrentFile.UnlimitedTime}},
			    	 {{.CurrentFile.IsEndToEndEncrypted}},
			    	 {{ or (and (eq .ActiveUser.Id .CurrentFile.UploaderId) (.ActiveUser.HasPermissionReplace))
			    	 	(.ActiveUser.HasPermissionReplaceOtherUploads) }});">
		   	    <i class="bi bi-pencil"></i>
			</button>

{{ end }}

{{ define "admin_button_delete" }}
			<button id="button-delete-{{ .CurrentFile.Id}}"
			   type="button"
               title="{{$.UI.T "common.delete"}}"
			    {{ if and (ne .ActiveUser.Id .CurrentFile.UploaderId) (not .ActiveUser.HasPermissionDeleteOtherUploads) }}
			    	disabled
			    {{ end }}
			   class="btn btn-outline-danger btn-sm"
			   onclick="deleteFile('{{ .CurrentFile.Id }}')">
			   <i class="bi bi-trash3"></i>
			</button>
{{ end }}

{{ define "admin_button_copyurl" }}
		    <button id="url-button-{{ .CurrentFile.Id }}" type="button"
                data-clipboard-text="{{ .CurrentFile.UrlDownload }}" class="copyurl btn btn-outline-light btn-sm" title="{{$.UI.T "common.copyURL"}}"><i class="bi bi-copy"></i> URL</button>
		    <button type="button" class="btn btn-outline-light btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
		    </button>
			<ul class="dropdown-menu dropdown-menu-end" data-bs-theme="dark" >
	{{ if ne .CurrentFile.UrlHotlink "" }}
                <li style="cursor: pointer;"><a class="dropdown-item copyurl" title="{{$.UI.T "files.copyHotlink"}}"
                    data-clipboard-text="{{ .CurrentFile.UrlHotlink }}"><i class="bi bi-copy"></i> {{$.UI.T "files.hotlink"}}</a></li>
		{{ else }}
                <li><a class="dropdown-item disabled">{{$.UI.T "files.noHotlink"}}</a></li>
	{{ end }}
			</ul>
{{ end }}

{{ define "admin_button_share" }}
            <button type="button" class="btn btn-outline-light btn-sm" title="{{$.UI.T "common.share"}}" onclick="shareUrl(event, '{{ .CurrentFile.Id }}',
		       '{{ .CurrentFile.UrlDownload }}')">
		       <!-- For some reason bi-share does not always show up, using the svg fixes it -->
		       	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi" viewBox="0 0 16 16">
 				 <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.5 2.5 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5m-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/>
			</svg>
</button>
		    <button type="button" id="shareDropdown-{{ .CurrentFile.Id }}" class="btn btn-outline-light btn-sm dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
		    </button>
			<ul class="dropdown-menu dropdown-menu-end" data-bs-theme="dark" >
                <li style="cursor: pointer;"><a class="dropdown-item" id="qrcode-{{ .CurrentFile.Id }}" title="{{$.UI.T "files.openQR"}}" onclick="showQrCode('{{ .CurrentFile.UrlDownload }}');"><i class="bi bi-qr-code"></i> {{$.UI.T "files.qr"}}</a></li>
			    <li style="cursor: pointer;"><a class="dropdown-item" id="email-{{ .CurrentFile.Id }}" href="mailto:?body={{ .CurrentFile.UrlDownload | urlquery}}"
                   target="_blank" title="{{$.UI.T "files.emailShare"}}"><i class="bi bi-envelope"></i> {{$.UI.T "files.email"}}</a></li>
			</ul>
{{ end }}

{{ define "admin_modal_edit" }}

	<div class="modal fade" id="modaledit" tabindex="-1" aria-labelledby="m_filenamelabel" aria-hidden="true">
	  <div class="modal-dialog  modal-lg gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
        <h1 class="modal-title fs-5" id="m_filenamelabel">{{$.UI.T "common.filename"}}</h1>
	      </div>
	      <div class="modal-body">
		<div class="input-group mb-3">
		  <div class="input-group-text">
                <input type="checkbox" id="mc_download"  checked aria-label="{{$.UI.T "files.limitDownloads"}}" title="{{$.UI.T "files.limitDownloads"}}"  data-toggle-target="mi_edit_down" onchange="handleEditCheckboxChange(this)">
   		 </div>
          <span class="input-group-text modal-samesize-input-edit" id="edit_down">{{$.UI.T "files.limitDownloads"}}</span>
          <input type="number" min="1" id="mi_edit_down" class="form-control" aria-label="{{$.UI.T "files.remaining"}}" aria-describedby="edit_down" data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
                <input id="mc_expiry" type="checkbox" checked aria-label="{{$.UI.T "files.expire"}}" title="{{$.UI.T "files.expire"}}"  data-toggle-target="mi_edit_expiry" data-timestamp="" onchange="handleEditCheckboxChange(this)" >
   		 </div>
          <span class="input-group-text modal-samesize-input-edit" id="edit_expdate">{{$.UI.T "common.expiry"}}</span>
          <input type="text" id="mi_edit_expiry" class="form-control" aria-label="{{$.UI.T "common.expiry"}}" aria-describedby="edit_expdate"  data-allow-regular-paste>
		</div>
		<div class="input-group mb-3">
		  <div class="input-group-text">
                <input type="checkbox" id="mc_password" aria-label="{{$.UI.T "files.requirePassword"}}" title="{{$.UI.T "files.requirePassword"}}" data-toggle-target="mi_edit_pw" onchange="handleEditCheckboxChange(this)">
   		 </div>
          <span class="input-group-text modal-samesize-input-edit" id="edit_pw">{{$.UI.T "common.password"}}</span>
          <input type="text" id="mi_edit_pw" class="form-control" aria-label="{{$.UI.T "common.password"}}" disabled onclick="selectTextForPw(this)" aria-describedby="edit_pw"  data-allow-regular-paste>
		</div>

	      <div class="input-group mb-3" id="replaceGroup">
		  <div class="input-group-text">
            <input type="checkbox" id="mc_replace" aria-label="{{$.UI.T "files.replaceLabel"}}" title="{{$.UI.T "files.replaceLabel"}}" data-toggle-target="mi_edit_replace" onchange="handleEditCheckboxChange(this)">
		  </div>
          <span class="input-group-text modal-samesize-input-edit" id="edit_replace">{{$.UI.T "files.replace"}}</span>
          <select id="mi_edit_replace" class="form-select" aria-label="{{$.UI.T "files.replaceLabel"}}" disabled>
		  </select>
		</div>
	      </div>
	      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light"  aria-label="{{$.UI.T "common.close"}}" data-bs-dismiss="modal">{{$.UI.T "common.close"}}</button>
        <button type="button" class="btn btn-primary" data-fileid="" id="mb_save" onclick="editFile();">{{$.UI.T "common.saveChanges"}}</button>
	      </div>
	    </div>
	  </div>
	</div>

{{ end }}
