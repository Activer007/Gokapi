{{ define "users" }}
{{ template "header" . }}
<section id="container" class="management-workspace users-workspace" aria-labelledby="managementTitle">
<div class="page-heading"><div><h1 id="managementTitle">{{$.UI.T "nav.users"}}</h1><p>{{$.UI.T "users.workspaceHelp"}}</p></div>
<button id="add-user-btn" type="button" class="btn btn-primary primary-upload" onclick="showAddUserModal()"><i class="bi bi-plus-lg" aria-hidden="true"></i>{{$.UI.T "users.add"}}</button></div>
<div class="table-responsive management-table">
                    <table class="table table-dark">
                        <thead>
                            <tr>
                                <th scope="col">{{$.UI.T "common.user"}}</th>
                                <th scope="col">{{$.UI.T "users.group"}}</th>
                        <th scope="col">{{$.UI.T "users.lastOnline"}}</th>
                        <th scope="col">{{$.UI.T "users.uploads"}}</th>
                        <th scope="col">{{$.UI.T "users.permissions"}}
                                    <button type="button"
                                        class="btn btn-sm btn-link text-white-50 p-0 ms-1 align-baseline"
                                        id="permLegendBtn"
                                        data-bs-toggle="popover"
                                        data-bs-placement="top"
                                        data-bs-html="true"
                                        data-bs-trigger="focus"
                                        data-bs-content='
                                            <table class="table table-sm table-dark mb-0" style="font-size:0.85em">
                                              <tbody>
                                                <tr><td><i class="bi bi-box-arrow-in-down"></i></td><td>{{$.UI.T "users.createRequest"}}</td></tr>
                                                <tr><td><i class="bi bi-recycle"></i></td><td>{{$.UI.T "users.replaceOwn"}}</td></tr>
                                                <tr><td><i class="bi bi-eye"></i></td><td>{{$.UI.T "users.listOther"}}</td></tr>
                                                <tr><td><i class="bi bi-pencil"></i></td><td>{{$.UI.T "users.editOther"}}</td></tr>
                                                <tr><td><i class="bi bi-trash3"></i></td><td>{{$.UI.T "users.deleteOther"}}</td></tr>
                                                <tr><td><i class="bi bi-arrow-left-right"></i></td><td>{{$.UI.T "users.replaceOther"}}</td></tr>
                                                <tr><td><i class="bi bi-card-list"></i></td><td>{{$.UI.T "users.manageLogs"}}</td></tr>
                                                <tr><td><i class="bi bi-people"></i></td><td>{{$.UI.T "users.manage"}}</td></tr>
                                                <tr><td><i class="bi bi-sliders2"></i></td><td>{{$.UI.T "users.manageAPI"}}</td></tr>
                                              </tbody>
                                            </table>'
                                        title="{{$.UI.T "users.legend"}}"
                                        tabindex="0"
                                        aria-label="{{$.UI.T "users.showLegend"}}">
                                        <i class="bi bi-question-circle"></i>
                                    </button>
                                </th>
                                <th scope="col">{{$.UI.T "common.actions"}}</th>
                            </tr>
                        </thead>
                        <tbody id="usertable">
{{ range .Users }}
                            <tr id="row-{{ .User.Id }}">
                                <td>{{ .User.Name }}</td>
                                <td  id="userlevel_{{ .User.Id }}">{{$.UI.UserLevel .User.UserLevel}}</td>
            			<td><span id="cell-lastonline-{{ .User.Id }}"></span></td>
				   <script>
insertLastOnlineDate({{ .User.LastOnline }}, "cell-lastonline-{{ .User.Id }}");</script>
                                <td>{{ .UploadCount }}</td>
            			<td class="prevent-select">
            			
            			
        <i id="perm_guest_upload_{{ .User.Id }}" class="bi bi-box-arrow-in-down {{if not .User.HasPermissionCreateFileRequests}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionCreateFileRequests) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.createRequest"}}" data-permission="PERM_GUEST_UPLOAD"></i>
            			
        <i id="perm_replace_{{ .User.Id }}" class="bi bi-recycle {{if not .User.HasPermissionReplace}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionReplace) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.replaceOwn"}}" data-permission="PERM_REPLACE"></i>
		
        <i id="perm_list_{{ .User.Id }}" class="bi bi-eye {{if not .User.HasPermissionListOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionListOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.listOther"}}" data-permission="PERM_LIST"></i>
		
        <i id="perm_edit_{{ .User.Id }}" class="bi bi-pencil {{if not .User.HasPermissionEditOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionEditOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.editOther"}}" data-permission="PERM_EDIT"></i>
		
        <i id="perm_delete_{{ .User.Id }}" class="bi bi-trash3 {{if not .User.HasPermissionDeleteOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionDeleteOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.deleteOther"}}" data-permission="PERM_DELETE"></i>
		
        <i id="perm_replace_other_{{ .User.Id }}" class="bi bi-arrow-left-right {{if not .User.HasPermissionReplaceOtherUploads}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionReplaceOtherUploads) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.replaceOther"}}" data-permission="PERM_REPLACE_OTHER"></i>
		
        <i id="perm_logs_{{ .User.Id }}" class="bi bi-card-list {{if not .User.HasPermissionManageLogs}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionManageLogs) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.manageLogs"}}" data-permission="PERM_LOGS"></i>

        <i id="perm_users_{{ .User.Id }}" class="bi bi-people {{if not .User.HasPermissionManageUsers}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionManageUsers) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.manage"}}" data-permission="PERM_USERS"></i>

        <i id="perm_api_{{ .User.Id }}" class="bi bi-sliders2 {{if not .User.HasPermissionManageApi}}perm-notgranted{{else}}perm-granted{{end}} {{if or (not $.ActiveUser.HasPermissionManageApi) (or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id))}}perm-nochange{{end}}" title="{{$.UI.T "users.manageAPI"}}" data-permission="PERM_API"></i>
		
		
            			</td>
                                <td>
			        <div class="btn-group" role="group">
                                {{if $.IsInternalAuth}}
                                <button id="pwchange-{{ .User.Id }}" type="button" class="btn btn-outline-light btn-sm" {{if or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id)}}disabled{{end}} onclick="showResetPwModal('{{ .User.Id }}', '{{ .User.Name }}')" title="{{$.UI.T "users.resetPassword"}}"><i class="bi bi-key-fill"></i></button>
                                {{end}}
                                
                                {{if not .User.IsAdmin}}
                                <button id="changeRank_{{ .User.Id }}" type="button" onclick="changeRank({{ .User.Id }}, 'ADMIN', 'changeRank_{{ .User.Id }}')" title="{{$.UI.T "users.promote"}}" {{ if or (eq .User.Id $.ActiveUser.Id) (not $.ActiveUser.IsAdmin)}}disabled{{end}} class="btn btn-outline-light btn-sm">
		                        	<i class="bi bi-chevron-double-up"></i></button>
                                {{ else }}
                                 <button id="changeRank_{{ .User.Id }}" type="button" onclick="changeRank({{ .User.Id }}, 'USER', 'changeRank_{{ .User.Id }}')" {{if or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id)}}disabled{{end}} title="{{$.UI.T "users.demote"}}" class="btn btn-outline-light btn-sm">
		                        	<i class="bi bi-chevron-double-down"></i></button>                                
                                {{ end }}
                                
                                
                                <button id="delete-{{ .User.Id }}" type="button" class="btn btn-outline-danger btn-sm" {{if or (.User.IsSuperAdmin) (eq .User.Id $.ActiveUser.Id)}}disabled{{end}} onclick="showDeleteUserModal('{{ .User.Id }}', '{{ .User.Name }}')" title="{{$.UI.T "common.delete"}}"><i class="bi bi-trash3"></i></button>
                                </div></td>
                            </tr>
{{ end }}
                        </tbody>
                    </table>
                </div>
</section>
    <div id="toastnotification" class="toastnotification" role="status" aria-live="polite" aria-atomic="true" data-default="{{$.UI.T "users.invalidNotice"}}"></div>
	
	<!-- Modal for deletion confirmation -->
	<div class="modal" tabindex="-1" id="deleteModal" aria-labelledby="deleteUserTitle">
	  <div class="modal-dialog gokapi-dialog">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
        <h2 class="modal-title fs-5" id="deleteUserTitle">{{$.UI.T "users.delete"}}</h2>
	      </div>
	      <div class="modal-body">
        <p>{{$.UI.T "users.deleteBefore"}} <span id="deleteModalBody" class="fw-bold"></span>{{$.UI.T "users.deleteAfter"}}</p>
		<div class="form-check form-check-inline">
		  <input class="form-check-input" type="checkbox"  id="checkboxDelete" value="">
		  <label class="form-check-label" for="checkboxDelete">
            {{$.UI.T "users.deleteFiles"}}
		  </label>
		</div>
		</div>
	      <div class="modal-footer">
        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.cancel"}}</button>
        <button type="button" id="buttonDelete" class="btn btn-danger">{{$.UI.T "users.delete"}}</button>
	      </div>
	    </div>
	  </div>
	</div>
	
	
	
	<!-- Bootstrap Modal for Adding a New User -->
	<div class="modal fade" id="newUserModal" tabindex="-1" aria-labelledby="newUserModalLabel" aria-hidden="true">
	  <div class="modal-dialog modal-dialog-scrollable credential-modal">
	    <div class="modal-content gokapi-dialog">
	      <div class="modal-header">
        <h2 class="modal-title fs-5" id="newUserModalLabel">{{$.UI.T "users.create"}}</h2>
	      </div>
	      <div class="modal-body">
		<form id="newUserForm" data-credential-entry onsubmit="event.preventDefault(); addNewUser();">
		  <div class="mb-3">
		  <div class="text-start">
            <label for="e_userName" class="form-label">{{$.UI.T "login.username"}}</label>
		    </div>
            <input type="text" class="form-control" id="e_userName" minlength="2" placeholder="{{$.UI.T "users.enterName"}}" required>
			{{if .IsInternalAuth}}<p class="form-text text-white-50 mt-2">{{$.UI.T "users.autoPasswordHelp"}}</p>{{end}}
	         </div>
		</form>
		{{template "user_credentials" $.UI}}
	      </div>
	      <div class="modal-footer">
        <button type="button" data-credential-actions class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.cancel"}}</button>
        <button type="submit" data-credential-actions form="newUserForm" id="mb_addUser" class="btn btn-primary">{{$.UI.T "users.add"}}</button>
        <button type="button" data-credential-close hidden class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.close"}}</button>
	      </div>
	    </div>
	  </div>
	  </div>
	
	
	<!-- Modal for Reset Password -->
	<div class="modal  fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
	  <div class="modal-dialog modal-dialog-scrollable credential-modal text-start">
	    <div class="modal-content gokapi-dialog">
	      <!-- Modal Header -->
	      <div class="modal-header">
        <h2 class="modal-title fs-5" id="resetPasswordModalLabel">{{$.UI.T "users.resetPassword"}}</h2>
	      </div>

	      <!-- Modal Body -->
	      <div class="modal-body">
		
		<div id="formentryReset" data-credential-entry>
        <p>{{$.UI.T "users.resetPrompt"}} <span  class="fw-bold" id="l_userpwreset"></span>:</p>

		<!-- Option 1: Force user to set a new password on next login -->
		<div class="form-check mb-3">
		  <input 
		    type="radio" 
		    id="forceNewPassword" 
		    name="resetOption" 
		    class="form-check-input" 
		    value="forceNew" 
		    checked>
		  <label for="forceNewPassword" class="form-check-label">
            {{$.UI.T "users.forcePassword"}}
		  </label>
		</div>

		<!-- Option 2: Generate and display a random password -->
		<div class="form-check mb-3">
		  <input 
		    type="radio" 
		    id="generateRandomPassword" 
		    name="resetOption" 
		    class="form-check-input" 
		    value="generateRandom">
		  <label for="generateRandomPassword" class="form-check-label">
            {{$.UI.T "users.generatePassword"}}
		  </label>
		</div>
		
		
		</div>

		{{template "user_credentials" $.UI}}
	      </div>
	      <!-- Modal Footer -->
	      <div class="modal-footer">
        <button type="button" data-credential-actions id="cancelPasswordButton" class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.cancel"}}</button>
        <button type="button" data-credential-actions id="resetPasswordButton" class="btn btn-primary">{{$.UI.T "common.confirm"}}</button>
        <button type="button" data-credential-close hidden id="closeModalResetPw" class="btn btn-outline-light" data-bs-dismiss="modal">{{$.UI.T "common.close"}}</button>
	      </div>
	    </div>
	  </div>
	  </div>
{{template "permission_editor" .UI}}
<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>
<script>initPermissionEditors("user");</script>
<script>
	var isInternalAuth = {{.IsInternalAuth}};
	var isAdmin = {{.ActiveUser.IsAdmin}};
	var userPermissions = {{.ActiveUser.Permissions}};

	(function () {
		var el = document.getElementById('permLegendBtn');
		if (el) {
			new bootstrap.Popover(el, { sanitize: false });
		}
	})();
</script>
{{ template "pagename" "OverviewUsers"}}
{{ template "customjs" .}}
{{template "footer" .UI}}
{{ end }}

{{define "user_credentials"}}
<div data-user-credentials class="text-start credential-delivery" hidden>
    <p class="mb-3">{{.T "users.firstLoginHelp"}}</p>
    <div class="mb-3 credential-row">
        <label class="form-label w-100">{{.T "login.username"}}
            <input data-credential-field="username" type="text" class="form-control mt-1" readonly autocomplete="off" spellcheck="false">
        </label>
        <button type="button" data-credential-copy="username" class="btn btn-outline-light btn-sm">{{.T "users.copyUsername"}}</button>
    </div>
    <div class="mb-3 credential-row">
        <label class="form-label w-100">{{.T "users.temporaryPassword"}}
            <input data-credential-field="password" type="password" class="form-control mt-1" readonly autocomplete="off" spellcheck="false">
        </label>
        <div class="d-flex gap-2">
            <button type="button" data-credential-toggle class="btn btn-outline-light btn-sm" aria-pressed="false" aria-label="{{.T "users.showPassword"}}" title="{{.T "users.showPassword"}}"><i class="bi bi-eye" aria-hidden="true"></i></button>
            <button type="button" data-credential-copy="password" class="btn btn-outline-light btn-sm">{{.T "users.copyPassword"}}</button>
        </div>
    </div>
    <div class="mb-3 credential-row">
        <label class="form-label w-100">{{.T "users.loginUrl"}}
            <input data-credential-field="loginUrl" type="url" class="form-control mt-1" readonly autocomplete="off" spellcheck="false">
        </label>
        <button type="button" data-credential-copy="loginUrl" class="btn btn-outline-light btn-sm">{{.T "users.copyLoginUrl"}}</button>
    </div>
    <button type="button" data-credential-copy="all" class="btn btn-primary w-100">{{.T "users.copyAll"}}</button>
    <p class="form-text text-white-50 mt-2 mb-0">{{.T "users.credentialsOnce"}}</p>
    <div data-credential-fallback class="mt-3" hidden>
        <label class="form-label w-100">{{.T "clipboard.failed"}}
            <textarea class="form-control mt-1" rows="7" readonly autocomplete="off" spellcheck="false"></textarea>
        </label>
    </div>
</div>
{{end}}
