{{define "error"}}{{template "header" .}}
<section class="public-panel public-panel-wide" aria-labelledby="errorTitle">
  <i class="bi bi-exclamation-circle public-icon" aria-hidden="true"></i>
  {{if .IsGenericError}}
    {{if eq .ErrorId 0}}
      <h1 id="errorTitle">{{.UI.T "error.notFound.title"}}</h1>
      <p>{{.UI.T "error.notFound.help"}}</p>
      <p>{{.UI.T "error.requestNewLink"}}</p>
    {{end}}
    {{if eq .ErrorId 1}}
      <h1 id="errorTitle">{{.UI.T "error.upload.title"}}</h1>
      <p>{{.UI.T "error.upload.reasons"}}</p>
      <ul class="public-reasons"><li>{{.UI.T "error.upload.expired"}}</li><li>{{.UI.T "error.upload.limit"}}</li><li>{{.UI.T "error.upload.invalidURL"}}</li></ul>
      <p>{{.UI.T "error.requestNewLink"}}</p>
    {{end}}
    {{if eq .ErrorId 2}}
      <h1 id="errorTitle">{{.UI.T "error.cipher.title"}}</h1>
      <p>{{.UI.T "error.cipher.help"}}</p><p>{{.UI.T "error.cipher.contact"}}</p>
    {{end}}
    {{if eq .ErrorId 3}}
      <h1 id="errorTitle">{{.UI.T "error.unauthorized.title"}}</h1>
      <p>{{.UI.T "error.unauthorized.help"}}</p>
      <a href="./login?consent=true" class="btn btn-primary text-white">{{.UI.T "error.otherUser"}}</a>
    {{end}}
  {{else}}
    {{if eq .ErrorId 4}}
      <h1 id="errorTitle">{{.UI.T "error.oidc.title"}} {{.UI.T .ErrorTitle}}</h1>
      <p>{{.UI.T "error.oidc.help"}}</p>
      {{if .ErrorOauthMessage}}<p class="font-monospace">{{.ErrorOauthMessage}}</p>{{end}}
      <p class="font-monospace">{{.UI.T .ErrorMessage}}</p>
      <a href="./login?consent=true" class="btn btn-primary text-white">{{.UI.T "common.retry"}}</a>
    {{else}}
      <h1 id="errorTitle">{{.UI.T .ErrorTitle}}</h1><p>{{.UI.T .ErrorMessage}}</p>
    {{end}}
  {{end}}
</section>
{{template "pagename" "PublicError"}}
{{template "customjs" .}}
{{template "footer" .UI}}
{{end}}
