{{define "publicUpload"}}{{template "header" .}}


<section class="public-upload-page" aria-labelledby="publicUploadTitle">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="public-upload-content">
        <div class="public-upload-body">
          <div class="public-upload-heading"><p class="public-upload-eyebrow">{{.UI.T "nav.requests"}}</p><h1 id="publicUploadTitle">{{if .FileRequest.Name}}{{.FileRequest.Name}}{{else}}{{.UI.T "page.publicUpload"}}{{end}}</h1><p>{{.UI.T "request.publicHelp"}}</p></div>
{{ if ne .FileRequest.Notes "" }}
          <div class="collection-information">
            <h2>{{.UI.T "request.notes"}}</h2>
            <p class="mb-0">{{.FileRequest.Notes}}</p>
          </div>
{{ end }}
{{ if .FileRequest.HasRestrictions }}
          <div class="collection-information">
            <h2>{{.UI.T "request.restrictions"}}</h2>
            <ul>
    {{ if not (.FileRequest.IsUnlimitedTime) }}
              <li>{{.UI.T "request.until"}} <strong>
                  <span id="expirydate">{{ .FileRequest.Expiry }}</span>
                </strong>
              </li>
              <script>
                insertFormattedDate({{.FileRequest.Expiry}}, "expirydate");
              </script>
   {{ end }}
   {{ if or (not (.FileRequest.IsUnlimitedSize)) (lt .FileRequest.CombinedMaxSize 5000) }}
              <li>{{.UI.T "request.maxSize"}} <strong>
                  <span id="maxfilesize"></span>
                </strong>
              </li>
              <script>
                insertReadableSize({{.FileRequest.CombinedMaxSize}}, 1024 * 1024, "maxfilesize");
              </script>
   {{ end }}
       {{ if not (.FileRequest.IsUnlimitedFiles) }}
              <li>{{.UI.T "request.remainingCount"}} <strong id="publicFilesRemaining">{{ .FileRequest.FilesRemaining }}</strong>
              </li>
       {{ end }}
            </ul>
          </div>
{{ end }}
          <div id="uploadBox" class="upload-box public-drop-area">
            <img class="public-upload-art" src="./assets/brand/share-folder-v1.png" width="210" height="140" alt="" aria-hidden="true">
            <div class="public-upload-prompt"><p class="mb-2 fs-5">{{.UI.T "request.drop"}}</p>
            <p class="mb-3 opacity-75">{{.UI.T "files.pasteHint"}}</p>
            <button type="button" id="publicChooseFiles" class="btn btn-primary" onclick="document.getElementById('fileInput').click()">{{.UI.T "files.choose"}}</button>
            <input type="file" id="fileInput" class="d-none" multiple aria-label="{{.UI.T "files.choose"}}"></div>
          </div>
          <div id="fileList" class="pu-file-list" aria-label="{{.UI.T "request.queue"}}"></div>
          <div class="public-upload-submit">
            <button class="btn btn-primary" disabled onClick="initUpload();" id="uploadbutton">
		  {{.UI.T "request.startUpload"}}
	    </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>


<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
  <div class="modal-dialog gokapi-dialog">
    <div class="modal-content gokapi-dialog">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="errorModalLabel">{{.UI.T "request.failed"}}</h2>
      </div>
      <div class="modal-body">
        <span id="span-modal-error"></span>
      </div>
      <div class="modal-footer">
        <button type="button" data-bs-dismiss="modal" data-bs-target="#errorModal" class="btn btn-primary">{{.UI.T "common.continue"}}</button>
      </div>
    </div>
  </div>
</div>

<!-- All Uploaded Modal -->
<div class="modal fade" id="allUploadedModal" tabindex="-1" aria-labelledby="allUModalLabel" aria-hidden="true">
  <div class="modal-dialog gokapi-dialog">
    <div class="modal-content gokapi-dialog">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="allUModalLabel">{{.UI.T "common.success"}}</h2>
      </div>
      <div class="modal-body">
        {{.UI.T "request.allUploaded"}}
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-primary" data-bs-dismiss="modal">{{.UI.T "common.close"}}</button></div>
    </div>
  </div>
</div>


<script src="./js/min/public_upload.min.js?v={{template "js_admin_version"}}"></script>

<script>

const fileInput = document.getElementById('fileInput');
const fileList = document.getElementById('fileList');
const filesMap = new Map();
const errorModal = new bootstrap.Modal(document.getElementById('errorModal'));
const uploadBox = document.getElementById('uploadBox');


const CHUNK_SIZE = {{.ChunkSize}} * 1024 * 1024;
const API_BASE = "./api/uploadrequest/chunk/";
const RESERVE_URL = API_BASE + "reserve";
const UNRESERVE_URL = API_BASE + "unreserve";
const UPLOAD_URL = API_BASE + "add";
const COMPLETE_URL = API_BASE + "complete";
const FILE_REQUEST_ID = "{{ .FileRequest.Id }}";
const API_KEY = "{{ .FileRequest.ApiKey }}";
const MAX_FILE_SIZE = {{.FileRequest.CombinedMaxSize}} * 1024 * 1024;
const IS_UNLIMITED_FILES = {{ .FileRequest.IsUnlimitedFiles }};
const IS_UNLIMITED_TIME = {{ .FileRequest.IsUnlimitedTime }};
var maxFilesRemaining = {{.FileRequest.FilesRemaining}};
var isUploadInProgress = false;

createUploadBox();
setUnload();

</script>

{{ template "pagename" "PublicUpload"}}
{{ template "customjs" .}}
{{template "footer" .UI}}
{{end}}
