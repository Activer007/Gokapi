{{define "header"}}<!doctype html>
<html lang="{{.UI.Language}}" class="h-100">
  <head>
	{{if .BaseHref}}<base href="{{.BaseHref}}">{{end}}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

	<script src="./assets/dist/js/jquery.min.js"></script>
	<script src="./assets/dist/js/bootstrap.bundle.min.js"></script>
	<link href="./assets/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="apple-touch-icon" sizes="180x180" href="./favicon-apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="./favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="./favicon-16x16.png">
	<link rel="manifest" href="./site.webmanifest">
        <link href="./css/min/gokapi.min.{{ template "css_main"}}.css" rel="stylesheet">
	<link href="./assets/dist/icons/bootstrap-icons.min.css" rel="stylesheet">
	<script>window.gokapiMessages = {{.UI.Messages}};</script>
	<script src="./js/min/all_public.min.js?v={{template "js_admin_version"}}"></script>
	<title>{{.UI.Title}}</title>
{{ if .IsAdminView }}
	<script src="./assets/dist/js/dropzone.min.js?v={{ template "js_dropzone_version"}}"></script>
	<script src="./assets/dist/js/clipboard.min.js"></script>
	<script src="./assets/dist/js/datatables.min.js"></script>
	<script src="./assets/dist/js/qrcode.min.js"></script>
	<script src="./assets/dist/js/flatpickr.min.js"></script>
	<link  href="./assets/dist/css/dropzone.min.v2.css" rel="stylesheet">
	<link  href="./assets/dist/css/datatables.min.css" rel="stylesheet">
	<link  href="./assets/dist/css/flatpickr.min.css" rel="stylesheet">
	<link  href="./assets/dist/css/flatpickr.dark.min.css" rel="stylesheet">

    {{ if .CustomContent.UseCustomCss }}
	<link  href="./custom/custom.v{{.CustomContent.Version}}.css" rel="stylesheet">
    {{ end }}
{{ else }}
   {{ if .IsDownloadView }}
     <meta name="title" content="{{.UI.Title}}">
     <meta name="description" content="{{.UI.Description}}">
     <meta property="og:title" content="{{.UI.Title}}">
     <meta property="og:description" content="{{.UI.Description}}">
     <meta property="og:url" content="{{.BaseUrl}}">
   {{end}}
    {{ if .CustomContent.UseCustomCss }}
         <link  href="./custom/custom.v{{.CustomContent.Version}}.css" rel="stylesheet">
    {{ end }}
         <script src="./js/min/end2end_download.min.{{ template "js_e2eversion"}}.js"></script>
{{end}}
  </head>
  <body class="d-flex h-100 text-center text-white bg-dark {{if .IsAdminView}}admin-shell{{else}}public-shell{{end}}">
{{ if .IsAdminView }}
  <div class="d-flex w-100 min-vh-100 p-3 mx-auto flex-column admin-layout">
      <header class="masthead workspace-header">
        <div class="workspace-navigation">
          <a class="workspace-brand" href="./admin" title="{{.PublicName}}">{{.PublicName}}</a>
          <nav class="nav nav-masthead workspace-primary-nav" aria-label="{{.UI.T "nav.main"}}">
            <a class="nav-link {{ if eq .ActiveView 0}}active{{ end }}" {{if eq .ActiveView 0}}aria-current="page"{{end}} href="./admin"><i class="bi bi-folder" aria-hidden="true"></i><span>{{.UI.T "nav.files"}}</span></a>
            {{ if .ActiveUser.HasPermissionCreateFileRequests }}
            <a class="nav-link {{ if eq .ActiveView 4 }}active{{ end }}" {{if eq .ActiveView 4}}aria-current="page"{{end}} href="./filerequests"><i class="bi bi-box-arrow-in-up" aria-hidden="true"></i><span>{{.UI.T "nav.requests"}}</span></a>
            {{ end }}
            {{ if and .ActiveUser.HasPermissionManageUsers .IsUserTabAvailable }}
            <a class="nav-link {{ if eq .ActiveView 3 }}active{{ end }}" {{if eq .ActiveView 3}}aria-current="page"{{end}} href="./users"><i class="bi bi-people" aria-hidden="true"></i><span>{{.UI.T "nav.users"}}</span></a>
            {{ end }}
            {{ if .ShowApiMenu }}
            <a class="nav-link {{ if eq .ActiveView 2 }}active{{ end }}" {{if eq .ActiveView 2}}aria-current="page"{{end}} href="./apiKeys"><i class="bi bi-code-slash" aria-hidden="true"></i><span>{{.UI.T "nav.api"}}</span></a>
            {{ end }}
            {{ if .ActiveUser.HasPermissionManageLogs }}
            <a class="nav-link {{ if eq .ActiveView 1 }}active{{ end }}" {{if eq .ActiveView 1}}aria-current="page"{{end}} href="./logs"><i class="bi bi-activity" aria-hidden="true"></i><span>{{.UI.T "nav.status"}}</span></a>
            {{ end }}
          </nav>
          <div class="workspace-account">
            {{template "language_switch" .UI}}
            {{if .IsLogoutAvailable}}
            <div class="dropdown workspace-user-menu">
              <button class="btn workspace-user dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="{{.UI.T "nav.account"}}" title="{{if .IsUserTabAvailable}}{{.ActiveUser.Name}}{{else}}{{.UI.T "nav.account"}}{{end}}">
                <i class="bi bi-person" aria-hidden="true"></i><span>{{if .IsUserTabAvailable}}{{.ActiveUser.Name}}{{else}}{{.UI.T "nav.account"}}{{end}}</span>
              </button>
              <ul class="dropdown-menu dropdown-menu-end" data-bs-theme="dark"><li><button type="button" class="dropdown-item" onclick="doLogout()">{{.UI.T "nav.logout"}}</button></li></ul>
            </div>
            {{else if .IsUserTabAvailable}}<span class="workspace-user" title="{{.ActiveUser.Name}}"><i class="bi bi-person" aria-hidden="true"></i><span>{{.ActiveUser.Name}}</span></span>{{end}}
          </div>
        </div>
      </header>
  {{template "clipboard_fallback" .UI}}
  <main class="workspace-main">
{{ else }}
  <div class="d-flex w-100 mx-auto flex-column public-layout">
    <header class="public-header">
      <a class="workspace-brand" href="./index">{{.PublicName}}</a>
      {{template "language_switch" .UI}}
    </header>
    <main class="public-main">
{{ end }}
{{end}}
