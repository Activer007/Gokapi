{{define "download_password"}}{{template "header" .}}
{{if .EndToEndEncryption}}<script>parseHashValue({{.Id}});</script>{{end}}
<section class="public-panel" aria-labelledby="downloadPasswordTitle">
  <i class="bi bi-lock public-icon" aria-hidden="true"></i>
  <h1 id="downloadPasswordTitle">{{.UI.T "page.password"}}</h1>
  <p>{{.UI.T "download.passwordHelp"}}</p>
  <form method="post" action="./d?id={{.Id}}" id="form" name="form" onsubmit="return submitForm()">
    <label class="form-label" for="passwordFile">{{.UI.T "download.enterPassword"}}</label>
    <input type="password" minlength="1" class="form-control" id="passwordFile" autocomplete="current-password" required>
    <input type="hidden" id="pw_hidden" name="password">
    {{if .IsFailedLogin}}<div class="public-form-error" role="alert">{{.UI.T "download.invalidPassword"}}</div>{{end}}
    <button type="submit" id="submitbutton" class="btn btn-primary w-100 mt-4">{{.UI.T "common.continue"}}</button>
  </form>
</section>
<script>
function submitForm(){
	document.getElementById("passwordFile").disabled = true;
	document.getElementById("pw_hidden").value = document.getElementById("passwordFile").value;
	document.getElementById("submitbutton").disabled = true;
	return true;
}
</script>
{{ template "pagename" "PublicDownloadPw"}}
{{ template "customjs" .}}
{{template "footer" .UI}}
{{end}}
