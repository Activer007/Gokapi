{{define "e2esetup"}}{{template "header" .}}

 
	<script src="./js/min/end2end_admin.min.{{ template "js_e2eversion"}}.js"></script>
	<script src="./js/min/streamsaver.min.js"></script>
	<script src="./js/min/wasm_exec.min.js"></script>
	<script src="./js/min/admin.min.{{ template "js_admin_version"}}.js"></script>

	
{{ if not .HasBeenSetup }}	
<section class="public-panel public-panel-wide encryption-panel" aria-labelledby="encryptionTitle">
  <i class="bi bi-shield-lock public-icon" aria-hidden="true"></i>
  <h1 id="encryptionTitle">{{$.UI.T "e2e.title"}}</h1>
  <p>{{$.UI.T "e2e.password"}}</p>
  <div class="d-flex align-items-center gap-3 mb-4">
    <kbd id="decryptionpw">{{$.UI.T "e2e.generating"}}</kbd>
    <button type="button" id="downpw" class="btn btn-outline-light flex-shrink-0" aria-label="{{$.UI.T "common.download"}}" disabled><i class="bi bi-download" aria-hidden="true"></i></button>
  </div>
  <div id="errordiv" class="public-form-error" role="alert" style="display:none"><span id="errormessage"></span></div>
  <p><strong>{{$.UI.T "e2e.backup"}}</strong></p>
  <p>{{$.UI.T "e2e.resetHelp"}}</p>
  <button type="button" id="genbutton" class="btn btn-primary" disabled onclick="window.location='./admin';">{{$.UI.T "common.continue"}}</button>
</section>
    <script>
	function downloadKey(key) {
	    const uInt8 = new TextEncoder().encode(key)

    const fileStream = streamSaver.createWriteStream('SupaShareE2E.txt', {
		size: uInt8.byteLength
	    })

	    const writer = fileStream.getWriter()
	    writer.write(uInt8)
	    writer.close()

	}
	
function newKey() {
    window.gokapiTransferBusy = true;
    localStorage.removeItem("e2ekey");
    let key;
    apiE2eMutexLockUnlock(false)
        .then(() => {
            try {
                key = GokapiE2EGetNewCipher(true);
                if (key instanceof Error) throw key;

                document.getElementById("decryptionpw").innerText = key;
                window.gokapiBackupPending = true;

                let data = GokapiE2EInfoEncrypt();
                if (data instanceof Error) throw data;

                return apiE2eStore(data);
            } catch (err) {
                throw err;
            }
        })
        .then(() => {
            localStorage.setItem("e2ekey", key);
            document.getElementById("downpw").onclick = function() {
                downloadKey(key);
            }
            document.getElementById("downpw").disabled = false;
            document.getElementById("genbutton").disabled = false;
        })
        .catch(err => {
            window.gokapiBackupPending = false;
            displayError(err);
        })
        .finally(async () => {
            try {
                await apiE2eMutexLockUnlock(true);
            } catch (error) {
                console.error("Failed to release E2E mutex after newKey: " + error);
            } finally {
                window.gokapiTransferBusy = false;
            }
        });
}

	loadWasm(newKey);
	
    </script>
    
{{ else }}	    
<section class="public-panel public-panel-wide encryption-panel" aria-labelledby="encryptionTitle">
  <i class="bi bi-shield-lock public-icon" aria-hidden="true"></i>
  <h1 id="encryptionTitle">{{$.UI.T "e2e.title"}}</h1>
  <p>{{$.UI.T "e2e.enterHelp"}}</p>
  <label for="password" class="form-label">{{$.UI.T "download.enterPassword"}}</label>
  <input type="password" class="form-control" id="password" name="password" autocomplete="off">
  <div id="errordiv" class="public-form-error" role="alert" style="display:none"><span id="errormessage"></span></div>
  <button type="button" id="enterpwbutton" class="btn btn-primary mt-4" onclick="saveKey()" disabled>{{$.UI.T "common.save"}}</button>
</section>
    <script>
	function saveKey() {
	    localStorage.removeItem("e2ekey");
	    let key = document.getElementById("password").value;
	    localStorage.setItem("e2ekey", key);

	    let output = GokapiE2ESetCipher(key);
	    if (output instanceof Error) {
		localStorage.removeItem("e2ekey"); 
		document.getElementById("password").value = "";
		displayError(output);
		return;
	    }
	    window.location = './admin';

	}
	
	loadWasm(function() {
	    document.getElementById("enterpwbutton").disabled = false;
	});
	
    </script>
{{ end }}
{{ template "pagename" "E2EGeneration"}}
{{ template "customjs" .}}
{{template "footer" .UI}}
{{end}}
