{{define "download"}}{{template "header" .}}
<section class="public-panel public-download" aria-labelledby="filename">
  <img class="download-art" src="./assets/brand/share-folder-v1.png" width="200" height="132" alt="" aria-hidden="true">
  {{if .EndToEndEncryption}}
    <h1 id="filename" class="filename-text">{{.UI.T "download.decrypting"}}</h1>
    <span class="badge text-bg-secondary"><i class="bi bi-lock me-1" aria-hidden="true"></i>{{.UI.T "download.encrypted"}}</span>
  {{else}}
    <h1 id="filename" class="filename-text">{{.Name}}</h1>
  {{end}}
  <dl class="download-metadata">
    <div><dt>{{.UI.T "download.size"}}</dt><dd>{{.Size}}</dd></div>
    <div><dt>{{.UI.T "download.uploadedAt"}}</dt><dd><time id="downloadUploadDate">{{.UI.T "download.uploadTimeUnknown"}}</time></dd></div>
  </dl>
  <script>insertLocalUploadDate({{.UploadDate}}, "downloadUploadDate");</script>
  <div id="buttondiv" class="download-actions">
    {{if .ClientSideDecryption}}
      <button id="downloadbutton" class="btn btn-primary" type="button" disabled onclick="Download(this);"><span id="wasmspinner" class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>{{.UI.T "common.loading"}}</button>
    {{else}}
      <a id="downloadbutton" class="btn btn-primary text-white" href="./downloadFile?id={{.Id}}" onclick="Download(this);">{{.UI.T "download.action"}}</a>
    {{end}}
  </div>
  <p id="downloadStatus" class="download-state" role="status"></p>
  <div id="errordiv" class="public-form-error" style="display:none" role="alert">
    <div id="errormessage"></div><p class="mt-2 mb-0">{{.UI.T "download.reopenHelp"}}</p>
  </div>
</section>
{{ if .ClientSideDecryption }}
        <script src="./js/min/polyfill.min.js"></script>
        <script src="./js/min/streamsaver.min.js"></script>
        <script src="./js/min/wasm_exec.min.js"></script>
        
        <script>
        {{ if .EndToEndEncryption }}
        parseHashValue({{.Id}});
        {{ end }}
        
        const go = new Go(); // Defined in wasm_exec.js
        const WASM_URL = 'main.wasm?v=1';

        var wasm;

        async function initialiseDownload() {
            try {
                const response = await fetch(WASM_URL);
                if (!response.ok) throw new Error(t("download.initialiseFailed"));
                const obj = 'instantiateStreaming' in WebAssembly
                    ? await WebAssembly.instantiateStreaming(response, go.importObject)
                    : await WebAssembly.instantiate(await response.arrayBuffer(), go.importObject);
                wasm = obj.instance;
                go.run(wasm).catch(displayError);
                document.getElementById("wasmspinner").style.display = "none";
                document.getElementById("downloadbutton").disabled = false;
                document.getElementById("downloadbutton").textContent = t("download.action");
            } catch (err) {
                displayError(err);
            }
        }
        initialiseDownload();

        async function DownloadEncrypted() {
            window.gokapiTransferBusy = true;
            let reader;
            let writer;
            try {
                {{ if .EndToEndEncryption }}
                let key = sessionStorage.getItem("key-{{ .Id }}");
                sessionStorage.removeItem("key-{{ .Id }}"); 
                let filename = sessionStorage.getItem("fn-{{ .Id }}");
                sessionStorage.removeItem("fn-{{ .Id }}"); 
                {{ else }}
                let key = "{{ .Cipher }}";
                {{ end }}
                const response  = await GokapiDecrypt(key, "./downloadFile?id={{ .Id }}");
                if (response instanceof Error) {
                    throw response;
                }
                
                const readableStream = response.body;
                reader = response.body.getReader();
                {{ if .UsesHttps }}
                streamSaver.mitm = './serviceworker/index.html';
                {{ else }}
                console.log("SupaShare is not being accessed through https, therefore an external serviceworker will be used");
                streamSaver.mitm = 'https://forceu.github.io/Gokapi/internal/webserver/web/static/serviceworker/index.html';
                {{ end }}
                {{ if .EndToEndEncryption }}
                const fileStream = streamSaver.createWriteStream(filename);
                {{ else }}
                const fileStream = streamSaver.createWriteStream({{.Name }});
                {{ end }}
                         
                writer = fileStream.getWriter();
                window.writer = writer;

                const pump = () => reader.read()
                    .then(res => res.done ?
                    writer.close() :
                    writer.write(res.value).then(pump))

                await pump();
                document.getElementById("downloadStatus").textContent = t("download.transferred");
            } catch (err) {
                // Propagate a failed read to the output so a partial download
                // cannot remain open or be closed as a successful file.
                await Promise.allSettled([reader?.cancel(err), writer?.abort(err)]);
                const message = String(err?.message || err || t("download.transferFailed"));
                if (message.includes("Failed to fetch")) {
                    console.log(err);
                displayError(t("download.cors"));
                    
                } else {
                displayError(message);
                }
            } finally {
                window.gokapiTransferBusy = false;
            }
        }

        function displayError(err) {
            document.getElementById("downloadStatus").textContent = "";
            document.getElementById("buttondiv").style.display = "none";
            document.getElementById("errordiv").style.display = "block";
            document.getElementById("errormessage").textContent = t("common.error") + ": " + String(err?.message || err || t("download.transferFailed")).replace(/^Error:/gi, "");
            console.error('Caught exception', err)
        }


        function Download(button) {
            button.disabled = true;
            document.getElementById("downloadStatus").textContent = t("download.transferring");
            DownloadEncrypted().catch(err => {
                console.error('Error during download:', err);
                displayError(err);
            });
        }
        
        </script>
{{ else }}

        <script> 
           function Download(button) {
             document.getElementById("downloadStatus").textContent = t("download.browserStarted");
           }
        </script>
{{ end }}
{{ if .EndToEndEncryption }}
        <script> 
            let filename = sessionStorage.getItem("fn-{{ .Id }}");
            if(filename) {
                document.getElementById("filename").innerText = filename;
                document.title = filename + " · " + {{.UI.SiteTitle}};
            }
        </script>
{{ end }}
        
{{ template "pagename" "PublicDownload"}}
{{ template "customjs" .}}
        
{{template "footer" .UI}}
{{end}}
